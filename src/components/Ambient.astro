---
/**
 * Ambient tone behind glass surfaces: large, heavily blurred discs in the field grey and a warm
 * gold tint, so backdrop-blur has something to frost. Purely decorative, sits behind content.
 */
interface Props { class?: string; variant?: 'hero' | 'left' | 'right' | 'wide' }
const { class: className = '', variant = 'wide' } = Astro.props;
---
<div class:list={['ambient pointer-events-none absolute inset-0 -z-10 overflow-visible', className]} aria-hidden="true" data-variant={variant}>
  <span class="ambient-a"></span>
  <span class="ambient-b"></span>
  <span class="ambient-c"></span>
</div>

<style>
  /* Soft discs drawn as radial gradients: no filter: blur(), so nothing is re-blurred while the page moves. */
  .ambient span { position: absolute; border-radius: 9999px; }
  .ambient-a { background: radial-gradient(closest-side, rgba(230,230,226,1), rgba(230,230,226,.55) 50%, rgba(230,230,226,0)); }
  .ambient-b { background: radial-gradient(closest-side, rgba(232,220,192,1), rgba(232,220,192,.55) 50%, rgba(232,220,192,0)); } /* gold at ~30 % over white */
  .ambient-c { background: radial-gradient(closest-side, rgba(236,236,234,1), rgba(236,236,234,.55) 50%, rgba(236,236,234,0)); }

  [data-variant="hero"] .ambient-a { width: 80%; height: 75%; left: -20%; top: 0; }
  [data-variant="hero"] .ambient-b { width: 62%; height: 68%; right: -18%; top: 12%; }
  [data-variant="hero"] .ambient-c { width: 70%; height: 60%; left: 15%; bottom: -20%; }

  [data-variant="wide"] .ambient-a { width: 68%; height: 90%; left: -18%; top: 0; }
  [data-variant="wide"] .ambient-b { width: 56%; height: 80%; right: -16%; top: 20%; }
  [data-variant="wide"] .ambient-c { width: 60%; height: 70%; left: 22%; bottom: -25%; }

  [data-variant="left"] .ambient-a { width: 90%; height: 100%; left: -25%; top: -5%; }
  [data-variant="left"] .ambient-b { width: 60%; height: 70%; left: 20%; bottom: -20%; }
  [data-variant="left"] .ambient-c { display: none; }

  [data-variant="right"] .ambient-a { width: 90%; height: 100%; right: -25%; top: -5%; }
  [data-variant="right"] .ambient-b { width: 60%; height: 70%; right: 20%; bottom: -20%; }
  [data-variant="right"] .ambient-c { display: none; }
</style>
