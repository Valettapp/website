---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import BrowserFrame from './BrowserFrame.astro';
import MiniUI from './MiniUI.astro';
import SampleLabel from './SampleLabel.astro';
// HTML mockups with demo data; swap for crops of Valett_Reports___polish_mockup.pdf when it arrives.
const tiles = [
  { kind: 'reports', title: 'Reports', body: 'Cars, revenue, wait times and tips per shift, per venue, per driver.' },
  { kind: 'tickets', title: 'Tickets and customers', body: 'Every visit on one record; VIP tiers that follow the guest.' },
  { kind: 'residents', title: 'Residents', body: 'Permanent plans for buildings, with their own rules.' },
  { kind: 'validation', title: 'Validation', body: 'Venues stamp the ticket digitally; leakage ends.' },
  { kind: 'incidents', title: 'Incidents and compensation', body: 'Photos, timestamps, who touched the car, what was paid.' },
  { kind: 'drivers', title: 'Driver performance', body: 'Speed, ratings and tips, per driver, per shift.' },
  { kind: 'cash', title: 'Shift manager and cash variances', body: 'Who was on, what came in, what is missing.' },
  { kind: 'network', title: 'Network overview', body: 'Every venue on one map for operators and groups.' },
] as const;
---
<section id="back-office" class="section-pad scroll-mt-20" aria-labelledby="backoffice-title">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHead id="backoffice-title" eyebrow="Back office" title="Run one door or forty from the same screen." />
      <SampleLabel class="md:pb-2" />
    </div>
    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 md:mt-24">
      {tiles.map((t) => (
        <li class="flex flex-col">
          <div class="rounded-frame bg-field p-4 md:p-5">
            <BrowserFrame dense url={`admin.valettuae.com/${t.kind}`}>
              <div class="tile-ui relative aspect-[16/10] overflow-hidden"><MiniUI kind={t.kind} /></div>
            </BrowserFrame>
          </div>
          <div class="flex flex-1 flex-col gap-2 px-1 pt-5">
            <h3 class="t-h3 !text-[18px] md:!text-[20px]">{t.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-2">{t.body}</p>
            <div class="mt-auto pt-2"><Pill status="live" /></div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* The mini UIs are built at 360 px; scale to the tile width. */
  .tile-ui :global(.mini) { zoom: 0.72; width: 100%; max-width: none; }
  @media (min-width: 40rem) { .tile-ui :global(.mini) { zoom: 0.8; } }
  @media (min-width: 64rem) { .tile-ui :global(.mini) { zoom: 0.68; } }
  @media (min-width: 80rem) { .tile-ui :global(.mini) { zoom: 0.72; } }
</style>
