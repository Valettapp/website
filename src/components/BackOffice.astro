---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import BrowserFrame from './BrowserFrame.astro';
import SampleLabel from './SampleLabel.astro';
import Ambient from './Ambient.astro';
import superAdmin from '../assets/reports/super-admin.jpg';
import shiftManager from '../assets/reports/shift-manager.jpg';
import reports from '../assets/reports/reports.jpg';
import tickets from '../assets/reports/tickets.jpg';
import residents from '../assets/reports/residents.jpg';
import validation from '../assets/reports/validation.jpg';
import incidents from '../assets/reports/incidents.jpg';
import drivers from '../assets/reports/drivers.jpg';
import cash from '../assets/reports/cash.jpg';
import network from '../assets/reports/network.jpg';
// Tiles are crops of the admin mockup (Valett_Reports___polish_mockup.pdf), one page per tile.
const tiles = [
  { img: reports, title: 'Reports', body: 'Cars, revenue, wait times and tips per shift, per venue, per driver.', url: 'reports' },
  { img: tickets, title: 'Tickets and customers', body: 'Every visit on one record; VIP tiers that follow the guest.', url: 'tickets' },
  { img: residents, title: 'Residents', body: 'Permanent plans for buildings, with their own rules.', url: 'residents' },
  { img: validation, title: 'Validation', body: 'Venues stamp the ticket digitally; leakage ends.', url: 'validation' },
  { img: incidents, title: 'Incidents and compensation', body: 'Photos, timestamps, who touched the car, what was paid.', url: 'incidents' },
  { img: drivers, title: 'Driver performance', body: 'Speed, ratings and tips, per driver, per shift.', url: 'performance' },
  { img: cash, title: 'Shift manager and cash variances', body: 'Who was on, what came in, what is missing.', url: 'cash' },
  { img: network, title: 'Network overview', body: 'Every venue on one map for operators and groups.', url: 'network' },
];
---
<section data-reveal-group id="back-office" class="section-pad scroll-mt-20" aria-labelledby="backoffice-title">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHead id="backoffice-title" eyebrow="Back office" title="Run one door or forty from the same screen." />
      <SampleLabel class="md:pb-2" text="Admin software, demo data" />
    </div>

    {/* Showcase: super admin dashboard + key controller */}
    <div class="relative mt-16 grid gap-6 md:mt-24 lg:grid-cols-12" data-reveal-stagger="scale"><Ambient variant="wide" class="-inset-y-[10%]" />
      <div class="glass-panel !rounded-frame p-3 md:p-6 lg:col-span-7">
        <BrowserFrame url="admin.valettuae.com">
          <Picture src={superAdmin} formats={['avif', 'webp']} widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 700px, 92vw" alt="Super admin dashboard: a map of six venues with live counts, stuck hooks, locations, staff on shift, today's tickets, revenue and average retrieve time." class="block w-full" loading="lazy" decoding="async" />
        </BrowserFrame>
      </div>
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div class="glass-panel !rounded-frame p-3 md:p-6">
          <BrowserFrame url="admin.valettuae.com/shift-manager">
            <Picture src={shiftManager} formats={['avif', 'webp']} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 480px, 92vw" alt="Shift manager screen: pending requests, active tickets, who is on shift, driver map and tip payouts." class="block w-full" loading="lazy" decoding="async" />
          </BrowserFrame>
        </div>
        <div class="flex flex-col gap-3 px-1">
          <h3 class="t-h3">One screen for the operator, one for every door.</h3>
          <p class="text-[16px] leading-relaxed text-ink-2">Operators and groups see every venue on a map with live counts. Each venue runs its own key controller, reports, staff and settings, and the guest page carries the venue’s brand, not ours. <Pill status="live" class="ms-1 align-[2px]" /></p>
        </div>
      </div>
    </div>

    <ul class="snap-row mt-16 sm:grid sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 md:mt-20" data-reveal-stagger="scale">
      {tiles.map((t) => (
        <li class="snap-item flex flex-col">
          <div class="rounded-frame bg-field p-3 md:p-4">
            <BrowserFrame dense url={`admin.valettuae.com/${t.url}`}>
              <Picture src={t.img} formats={['avif', 'webp']} widths={[400, 600, 900]} sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 84vw" alt={`${t.title} screen`} class="block w-full" loading="lazy" decoding="async" />
            </BrowserFrame>
          </div>
          <div class="flex flex-1 flex-col gap-2 px-1 pt-5">
            <h3 class="t-h3 !text-[18px] md:!text-[20px]">{t.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-2">{t.body}</p>
            <div class="mt-auto pt-2"><Pill status="live" /></div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
