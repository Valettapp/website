---
/** Matte-glass browser chrome for desktop mockups. */
interface Props { url?: string; class?: string; dense?: boolean }
const { url = 'app.valett.si', class: className = '', dense = false } = Astro.props;
---
<div class:list={['glass overflow-hidden rounded-[18px]', className]}>
  <div class:list={['flex items-center gap-2 border-b border-line', dense ? 'px-3 py-2' : 'px-4 py-3']} aria-hidden="true">
    <span class="flex gap-1.5">
      <span class:list={['rounded-full border border-ink/15', dense ? 'size-2' : 'size-2.5']}></span>
      <span class:list={['rounded-full border border-ink/15', dense ? 'size-2' : 'size-2.5']}></span>
      <span class:list={['rounded-full border border-ink/15', dense ? 'size-2' : 'size-2.5']}></span>
    </span>
    <span class:list={['mx-auto min-w-0 truncate rounded-[6px] bg-field text-ink-3', dense ? 'px-2 py-0.5 text-[9px]' : 'px-3 py-1 text-[11px]']}>{url}</span>
    <span class:list={[dense ? 'w-7' : 'w-10']}></span>
  </div>
  <div class="bg-white"><slot /></div>
</div>
