---
/**
 * The Valett film in a 20 px rounded glass frame.
 * - Poster first (AVIF/WebP via Astro <Picture>), 16:9 on desktop, 9:16 on mobile.
 * - `preload="none"`; the mp4 <source> is attached after first paint by the script below,
 *   and never when the user prefers reduced motion (autoplay variant).
 * - Until the film exists (site.film.mp4 === null) the poster placeholder is shown alone.
 */
import { Picture } from 'astro:assets';
import placeholder from '../assets/poster-placeholder.png';
import placeholderPortrait from '../assets/poster-placeholder-portrait.png';
import filmPoster from '../assets/film-poster.jpg';
import filmPosterPortrait from '../assets/film-poster-portrait.jpg';
import { site } from '../data/site';

interface Props {
  variant: 'hero' | 'full'; // hero: muted autoplay, no chrome. full: controls + captions + sound.
  class?: string;
  priority?: boolean;
}
const { variant, class: className = '', priority = false } = Astro.props;
const hasFilm = Boolean(site.film.mp4);
const poster = hasFilm ? filmPoster : placeholder;
const posterPortrait = hasFilm ? filmPosterPortrait : placeholderPortrait;
const posterSrcAttr = poster.src;
---
<figure
  class:list={['film glass rounded-frame p-2 md:p-3', className]}
  data-reveal
  data-film
  data-variant={variant}
  data-mp4={site.film.mp4 ?? ''}
  data-mp4-portrait={site.film.mp4Portrait ?? ''}
  data-mp4-alt={site.film.mp4 ?? ''}
  data-mp4-portrait-alt={site.film.mp4Portrait ?? ''}
>
  <div class:list={['film-box relative overflow-hidden rounded-[14px] bg-ink', hasFilm ? 'aspect-[9/16] md:aspect-video' : 'aspect-[4/3] md:aspect-[21/9]']}>
    {/* Poster: portrait on mobile, landscape on md+ (only when the film exists) */}
    {hasFilm && <Picture
      src={posterPortrait}
      formats={['avif', 'webp']}
      widths={[390, 780]}
      sizes="(max-width: 767px) 100vw, 0px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover md:hidden"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm && <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1280px) 1200px, (min-width: 768px) 92vw, 0px"
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover md:block"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm ? (
      <video
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 data-[ready]:opacity-100"
        poster={posterSrcAttr}
        preload="none"
        playsinline
        {...(variant === 'hero' ? { muted: true, loop: true, 'aria-label': 'The Valett film, silent preview' } : { controls: true, 'aria-label': 'The Valett film' })}
      >
        {site.film.captions && <track kind="captions" src={site.film.captions} srclang="en" label="English" default />}
      </video>
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 text-center text-white">
        <span class="inline-flex size-14 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
        </span>
        <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/60">The film · coming soon</p>
      </div>
    )}
  </div>
</figure>

<script>
  // Lazy-attach the film after first paint; respect reduced motion for the silent hero.
  // Routes, tried in order until one yields metadata: stream the primary url; fetch the alternate url whole
  // and play it from a blob; fetch the primary whole. Safari needs HTTP range support to stream, and some
  // hosts (the design preview) lack it, hence the blob routes. If every route fails, the reasons are shown in
  // the frame so the failure can be diagnosed from a screenshot.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const portrait = window.matchMedia('(max-width: 767px)').matches;
  const figures = document.querySelectorAll<HTMLElement>('[data-film]');
  const errName = (v: HTMLVideoElement) => (v.error ? ['', 'aborted', 'network', 'decode', 'src-not-supported'][v.error.code] || String(v.error.code) : 'no-error');
  const settle = (video: HTMLVideoElement, ms: number) => new Promise<string>((res) => {
    const done = (r: string) => { clearTimeout(t); res(r); };
    const t = setTimeout(() => done(video.readyState >= 1 ? 'ok' : 'timeout'), ms);
    video.addEventListener('loadedmetadata', () => done('ok'), { once: true });
    video.addEventListener('error', () => done(errName(video)), { once: true });
  });
  const reset = (video: HTMLVideoElement) => { video.pause(); video.querySelectorAll('source').forEach((s) => s.remove()); video.removeAttribute('src'); video.load(); };
  const tryStream = async (video: HTMLVideoElement, src: string) => {
    reset(video); video.preload = 'metadata';
    const source = document.createElement('source'); source.src = src; source.type = 'video/mp4';
    const p = settle(video, 8000);
    source.addEventListener('error', () => video.dispatchEvent(new Event('error')), { once: true });
    video.appendChild(source); video.load();
    return p;
  };
  const tryBlob = async (video: HTMLVideoElement, src: string) => {
    let res: Response;
    try { res = await fetch(src); } catch (e) { return `fetch failed (${(e as Error).message})`; }
    if (!res.ok) return `http ${res.status}`;
    const blob = await res.blob();
    if (!blob.size) return 'empty';
    reset(video); video.preload = 'auto'; video.src = URL.createObjectURL(blob); video.load();
    return settle(video, 8000);
  };
  const attach = async (fig: HTMLElement) => {
    const video = fig.querySelector('video');
    if (!video || video.dataset.ready) return;
    const primary = (portrait && fig.dataset.mp4Portrait) || fig.dataset.mp4;
    const alt = (portrait && fig.dataset.mp4PortraitAlt) || fig.dataset.mp4Alt;
    if (!primary) return;
    const variant = fig.dataset.variant;
    if (variant === 'hero' && reduce) return; // no autoplay under reduced motion
    video.dataset.ready = '1';
    // The player is inert while routes are tried: a play() on a sourceless element makes Safari reject what arrives next.
    const hadControls = video.controls; video.controls = false;
    fig.setAttribute('data-film-loading', '');
    const log: string[] = [];
    const routes: [string, () => Promise<string>][] = [[`stream ${primary}`, () => tryStream(video, primary)]];
    if (alt) routes.push([`fetch ${alt}`, () => tryBlob(video, alt)]);
    routes.push([`fetch ${primary}`, () => tryBlob(video, primary)]);
    let ok = false;
    for (const [name, run] of routes) {
      const r = await run();
      log.push(`${name}: ${r}`);
      if (r === 'ok') { ok = true; break; }
    }
    fig.removeAttribute('data-film-loading');
    video.controls = hadControls;
    if (ok) { if (variant === 'hero') video.play().catch(() => {}); return; }
    reset(video);
    const note = document.createElement('pre');
    note.className = 'film-diag';
    note.textContent = `The film could not load here.\n${log.join('\n')}\nua: ${navigator.userAgent.slice(0, 90)}`;
    fig.querySelector('.film-box')?.appendChild(note);
  };
  const run = () => {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { attach(e.target as HTMLElement); io.unobserve(e.target); }
      }, { rootMargin: '200px' });
      figures.forEach((f) => io.observe(f));
    } else figures.forEach(attach);
  };
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(run); else setTimeout(run, 300);
</script>

<style>
  [data-film-loading] video { opacity: 0; pointer-events: none; }
  .film-diag { position: absolute; inset: auto 12px 12px 12px; z-index: 5; margin: 0; padding: 10px 12px; border-radius: 10px; background: rgba(0,0,0,.75); color: #fff; font: 11px/1.45 ui-monospace, Menlo, monospace; white-space: pre-wrap; word-break: break-all; }
  [data-film-loading]::after { content: 'Loading the film…'; position: absolute; inset-inline: 0; bottom: 18%; text-align: center; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); pointer-events: none; }
</style>
