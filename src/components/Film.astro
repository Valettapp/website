---
/**
 * The Valett film in a 20 px rounded glass frame.
 * - Poster first (AVIF/WebP via Astro <Picture>), 16:9 on desktop, 9:16 on mobile.
 * - full (in-page film, controls): the <source> elements are in the HTML with preload="none", so nothing
 *   downloads until the viewer taps play, and iOS never sees a player whose sources arrive late (a tap on a
 *   sourceless <video> locks Safari at 00:00). Portrait cut on phones via <source media>. The poster is set
 *   when the film nears the viewport. Captions are burned into the film; the VTT track is opt-in (CC button).
 * - hero (muted autoplay): sources attached after first paint by the script, never under reduced motion.
 * - Until the film exists (site.film.mp4 === null) the poster placeholder is shown alone.
 */
import { Picture, getImage } from 'astro:assets';
import placeholder from '../assets/poster-placeholder.png';
import placeholderPortrait from '../assets/poster-placeholder-portrait.png';
import filmPoster from '../assets/film-poster.jpg';
import filmPosterPortrait from '../assets/film-poster-portrait.jpg';
import { site } from '../data/site';

interface Props {
  variant: 'hero' | 'full'; // hero: muted autoplay, no chrome. full: controls + captions + sound.
  class?: string;
  priority?: boolean;
}
const { variant, class: className = '', priority = false } = Astro.props;
const hasFilm = Boolean(site.film.mp4);
const poster = hasFilm ? filmPoster : placeholder;
const posterPortrait = hasFilm ? filmPosterPortrait : placeholderPortrait;
const full = variant === 'full';
// Poster images for the in-page player (set by script when it nears the viewport)
const posterWide = hasFilm && full ? await getImage({ src: filmPoster, format: 'webp', width: 1200, quality: 70 }) : null;
const posterTall = hasFilm && full ? await getImage({ src: filmPosterPortrait, format: 'webp', width: 720, quality: 70 }) : null;
---
<figure
  class:list={['film glass rounded-frame p-2 md:p-3', className]}
  data-reveal
  data-film
  data-variant={variant}
  data-mp4={site.film.mp4 ?? ''}
  data-mp4-portrait={site.film.mp4Portrait ?? ''}
  data-mp4-alt={site.film.mp4 ?? ''}
  data-mp4-portrait-alt={site.film.mp4Portrait ?? ''}
>
  <div class:list={['film-box relative overflow-hidden rounded-[14px] bg-ink', hasFilm ? 'aspect-[9/16] md:aspect-video' : 'aspect-[4/3] md:aspect-[21/9]']}>
    {/* Poster: portrait on mobile, landscape on md+ (only when the film exists) */}
    {hasFilm && !full && <Picture
      src={posterPortrait}
      formats={['avif', 'webp']}
      widths={[390, 780]}
      sizes="(max-width: 767px) 100vw, 0px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover md:hidden"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm && !full && <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1280px) 1200px, (min-width: 768px) 92vw, 0px"
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover md:block"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm && full ? (
      <video
        class="absolute inset-0 h-full w-full bg-ink object-cover"
        preload="none"
        playsinline
        controls
        aria-label="The Valett film"
        data-film-video
        data-poster-wide={posterWide?.src}
        data-poster-tall={posterTall?.src}
      >
        {site.film.mp4Portrait && <source src={site.film.mp4Portrait} type="video/mp4" media="(max-width: 767px)" />}
        <source src={site.film.mp4!} type="video/mp4" />
        {site.film.captions && <track kind="captions" src={site.film.captions} srclang="en" label="English" />}
      </video>
    ) : hasFilm ? (
      <video
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 data-[ready]:opacity-100"
        preload="none"
        playsinline
        muted
        loop
        aria-label="The Valett film, silent preview"
      >
        {site.film.captions && <track kind="captions" src={site.film.captions} srclang="en" label="English" default />}
      </video>
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 text-center text-white">
        <span class="inline-flex size-14 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
        </span>
        <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/60">The film · coming soon</p>
      </div>
    )}
  </div>
</figure>

<script>
  // Attach the film after first paint, as plain <source> elements the browser streams itself (the host serves
  // byte ranges, which is all Safari needs). The player is never made inert: if the browser ignores preload
  // (iOS Low Power Mode does), the user taps play and the fetch starts then. Browsers fall through to the
  // next <source> on their own; only when the last one fails is the reason shown in the frame.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const portrait = window.matchMedia('(max-width: 767px)').matches;
  const figures = document.querySelectorAll<HTMLElement>('[data-film]');
  const errName = (v: HTMLVideoElement) => (v.error ? ['', 'aborted', 'network', 'decode', 'src-not-supported'][v.error.code] || String(v.error.code) : 'no source could be played');
  const prepareFull = (fig: HTMLElement) => {
    const video = fig.querySelector<HTMLVideoElement>('video[data-film-video]');
    if (!video || video.dataset.ready) return;
    video.dataset.ready = '1';
    const poster = (portrait && video.dataset.posterTall) || video.dataset.posterWide;
    if (poster && !video.poster) video.poster = poster;
    const sources = video.querySelectorAll('source');
    sources[sources.length - 1]?.addEventListener('error', () => {
      if (fig.querySelector('.film-diag')) return;
      const note = document.createElement('pre');
      note.className = 'film-diag';
      note.textContent = `The film could not load here.\n${video.currentSrc || 'no source'}\n${errName(video)}\nua: ${navigator.userAgent.slice(0, 90)}`;
      fig.querySelector('.film-box')?.appendChild(note);
    });
  };
  const attach = (fig: HTMLElement) => {
    if (fig.dataset.variant === 'full') return prepareFull(fig);
    const video = fig.querySelector('video');
    if (!video || video.dataset.ready) return;
    const primary = (portrait && fig.dataset.mp4Portrait) || fig.dataset.mp4;
    const alt = (portrait && fig.dataset.mp4PortraitAlt) || fig.dataset.mp4Alt;
    if (!primary) return;
    const variant = fig.dataset.variant;
    if (variant === 'hero' && reduce) return; // no autoplay under reduced motion
    video.dataset.ready = '1';
    video.preload = variant === 'hero' ? 'auto' : 'metadata';
    const urls = alt && alt !== primary ? [primary, alt] : [primary];
    const sources = urls.map((u) => { const s = document.createElement('source'); s.src = u; s.type = 'video/mp4'; return s; });
    sources[sources.length - 1].addEventListener('error', () => {
      const note = document.createElement('pre');
      note.className = 'film-diag';
      note.textContent = `The film could not load here.\n${urls.join('\n')}\n${errName(video)}\nua: ${navigator.userAgent.slice(0, 90)}`;
      fig.querySelector('.film-box')?.appendChild(note);
    }, { once: true });
    video.prepend(...sources); // sources go before the <track>
    video.load();
    if (variant === 'hero') video.play().catch(() => {});
  };
  const run = () => {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { attach(e.target as HTMLElement); io.unobserve(e.target); }
      }, { rootMargin: '600px' });
      figures.forEach((f) => io.observe(f));
    } else figures.forEach(attach);
  };
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(run); else setTimeout(run, 300);
</script>

<style>
  .film-diag { position: absolute; inset: auto 12px 12px 12px; z-index: 5; margin: 0; padding: 10px 12px; border-radius: 10px; background: rgba(0,0,0,.75); color: #fff; font: 11px/1.45 ui-monospace, Menlo, monospace; white-space: pre-wrap; word-break: break-all; }
</style>
