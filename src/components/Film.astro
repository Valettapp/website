---
/**
 * The Valett film in a 20 px rounded glass frame.
 * - Poster first (AVIF/WebP via Astro <Picture>), 16:9 on desktop, 9:16 on mobile.
 * - `preload="none"`; the mp4 <source> is attached after first paint by the script below,
 *   and never when the user prefers reduced motion (autoplay variant).
 * - Until the film exists (site.film.mp4 === null) the poster placeholder is shown alone.
 */
import { Picture } from 'astro:assets';
import placeholder from '../assets/poster-placeholder.png';
import placeholderPortrait from '../assets/poster-placeholder-portrait.png';
import filmPoster from '../assets/film-poster.jpg';
import filmPosterPortrait from '../assets/film-poster-portrait.jpg';
import { site } from '../data/site';

interface Props {
  variant: 'hero' | 'full'; // hero: muted autoplay, no chrome. full: controls + captions + sound.
  class?: string;
  priority?: boolean;
}
const { variant, class: className = '', priority = false } = Astro.props;
const hasFilm = Boolean(site.film.mp4);
const poster = hasFilm ? filmPoster : placeholder;
const posterPortrait = hasFilm ? filmPosterPortrait : placeholderPortrait;
const posterSrcAttr = poster.src;
---
<figure
  class:list={['film glass rounded-frame p-2 md:p-3', className]}
  data-reveal
  data-film
  data-variant={variant}
  data-mp4={site.film.mp4 ?? ''}
  data-mp4-portrait={site.film.mp4Portrait ?? ''}
>
  <div class:list={['relative overflow-hidden rounded-[14px] bg-ink', hasFilm ? 'aspect-[9/16] md:aspect-video' : 'aspect-[4/3] md:aspect-[21/9]']}>
    {/* Poster: portrait on mobile, landscape on md+ (only when the film exists) */}
    {hasFilm && <Picture
      src={posterPortrait}
      formats={['avif', 'webp']}
      widths={[390, 780]}
      sizes="(max-width: 767px) 100vw, 0px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover md:hidden"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm && <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1280px) 1200px, (min-width: 768px) 92vw, 0px"
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover md:block"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />}
    {hasFilm ? (
      <video
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 data-[ready]:opacity-100"
        poster={posterSrcAttr}
        preload="none"
        playsinline
        {...(variant === 'hero' ? { muted: true, loop: true, 'aria-label': 'The Valett film, silent preview' } : { controls: true, 'aria-label': 'The Valett film' })}
      >
        {site.film.captions && <track kind="captions" src={site.film.captions} srclang="en" label="English" default />}
      </video>
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 text-center text-white">
        <span class="inline-flex size-14 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
        </span>
        <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/60">The film · coming soon</p>
      </div>
    )}
  </div>
</figure>

<script>
  // Lazy-attach the mp4 after first paint; respect reduced motion for the silent hero.
  // Two ways to feed the <video>: stream it (normal), or fetch the whole file and play it from a blob URL.
  // Safari needs HTTP range support to stream; hosts without it (the design preview) get the blob route,
  // and any browser falls back to it when streaming errors or never yields metadata.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const portrait = window.matchMedia('(max-width: 767px)').matches;
  const figures = document.querySelectorAll<HTMLElement>('[data-film]');
  const start = (video: HTMLVideoElement, variant?: string) => { video.dataset.ready = '1'; if (variant === 'hero') video.play().catch(() => {}); };
  const viaBlob = async (fig: HTMLElement, video: HTMLVideoElement, src: string) => {
    if (video.dataset.blob) return;
    video.dataset.blob = '1';
    fig.setAttribute('data-film-loading', '');
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(String(res.status));
      const url = URL.createObjectURL(await res.blob());
      video.querySelectorAll('source').forEach((s) => s.remove());
      video.src = url;
      video.load();
      start(video, fig.dataset.variant);
    } catch { /* leave the poster */ }
    fig.removeAttribute('data-film-loading');
  };
  const attach = (fig: HTMLElement) => {
    const video = fig.querySelector('video');
    if (!video || video.dataset.ready) return;
    const src = (portrait && fig.dataset.mp4Portrait) || fig.dataset.mp4;
    if (!src) return;
    const variant = fig.dataset.variant;
    if (variant === 'hero' && reduce) return; // no autoplay under reduced motion
    if (fig.hasAttribute('data-film-blob')) { viaBlob(fig, video, src); return; }
    const source = document.createElement('source');
    source.src = src;
    source.type = 'video/mp4';
    source.addEventListener('error', () => viaBlob(fig, video, src));
    video.addEventListener('error', () => viaBlob(fig, video, src));
    video.appendChild(source);
    video.load();
    start(video, variant);
    // No metadata after a few seconds of trying: the host cannot stream it, fetch it whole instead.
    const timer = window.setTimeout(() => { if (video.readyState < 1 && !video.dataset.blob) viaBlob(fig, video, src); }, 4000);
    video.addEventListener('loadedmetadata', () => window.clearTimeout(timer), { once: true });
    // The full variant only starts loading on play; arm the check then too.
    video.addEventListener('play', () => { window.setTimeout(() => { if (video.readyState < 1 && !video.dataset.blob) viaBlob(fig, video, src); }, 3000); }, { once: true });
  };
  const run = () => {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { attach(e.target as HTMLElement); io.unobserve(e.target); }
      }, { rootMargin: '200px' });
      figures.forEach((f) => io.observe(f));
    } else figures.forEach(attach);
  };
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(run); else setTimeout(run, 300);
</script>

<style>
  [data-film-loading] video { opacity: 0; }
  [data-film-loading]::after { content: 'Loading the film…'; position: absolute; inset-inline: 0; bottom: 18%; text-align: center; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); pointer-events: none; }
</style>
