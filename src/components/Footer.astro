---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { solutions } from '../data/solutions';
const year = 2026;
---
<footer class="bg-ink text-white">
  <div class="container-page py-16 md:py-20">
    <div class="flex flex-col gap-12 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5">
        <Wordmark class="text-[28px] md:text-[32px]" />
        <address class="text-ink-text-2 text-[15px] not-italic leading-relaxed">{site.address.map((l) => <span class="block">{l}</span>)}</address>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3 text-[15px] text-ink-text-2">
        <li><a class="hover:text-white transition-colors" href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.instagram && <li><a class="hover:text-white transition-colors" href={site.instagram} rel="noopener" target="_blank">Instagram</a></li>}
        <li><a class="hover:text-white transition-colors" href="/privacy">Privacy</a></li>
      </ul>
    </div>
    <nav class="mt-12 border-t border-ink-line pt-8" aria-label="Valett for every venue">
      <p class="text-[12px] uppercase tracking-[0.14em] text-ink-text-3">Valett for every door</p>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-[15px] text-ink-text-2">
        {solutions.map((s) => (
          <li><a class="hover:text-white transition-colors" href={`/${s.slug}`}>{s.nav}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mt-10 flex flex-col gap-2 border-t border-ink-line pt-6 text-[14px] text-ink-text-3 md:flex-row md:justify-between">
      <p>© {year} Valett</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
