---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import GuestPhone from './GuestPhone.astro';
import Ambient from './Ambient.astro';
import LoopFigure from './LoopFigure.astro';
import { site } from '../data/site';
---
<section data-reveal-group id="guest" class="section-pad scroll-mt-20" aria-labelledby="guest-title">
  <div class="container-page">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="flex flex-col gap-6 lg:col-span-5 lg:sticky lg:top-28">
        <SectionHead id="guest-title" eyebrow="The guest page" title="Nothing to download. Nothing to remember." />
        <p class="t-body measure">
          The valet photographs the car. The guest gets a ticket on their phone from the QR, with their car’s photo on it. From then on they can see where it is, ask for it from the table, message the shift manager and tip the driver, in English or Arabic, without creating an account.
        </p>
        <p class="t-caption measure">
          Private message line to the shift manager, hidden from the driver. Rate, tip and receipt by text.
        </p>
      </div>
      <div class="lg:col-span-7" data-reveal="right">
        <div class="relative"><Ambient variant="wide" class="-inset-[8%]" />
        <div class="glass-panel !rounded-frame px-5 py-12 md:px-10 md:py-16">
          <GuestPhone />
        </div>
        </div>
      </div>
    </div>
    {site.requestLoop && (
      <div class="mt-16 md:mt-24">
        <p class="t-caption measure">One tap on the guest’s phone. The request reaches the driver, and the car is on its way.</p>
        <LoopFigure
          class="mt-5"
          name="request"
          mobile="4x3"
          bg="#efeeea"
          label="The guest taps Request My Car. The screen moves to Request received, then Your driver is bringing your car, as a white Land Rover Defender pulls up beside the phone."
        />
      </div>
    )}
  </div>
</section>
