---
/**
 * GuestPhone — the real guest page rebuilt in HTML (reference: guest screens + recording 2).
 * Five deterministic, resettable states. Venue: THE MARQUEE (fictional).
 * Under reduced motion the final state renders first and no timers run.
 */
import { Picture } from 'astro:assets';
import carGuest from '../assets/car-guest.jpg';
import Icon from './Icon.astro';
import Plate from './Plate.astro';

interface Props {
  /** Render one state with no controls or script. Used in the hero story. */
  static?: boolean;
  /** Which state a static phone shows (default 4, driver on the way). */
  state?: 1 | 2 | 3 | 4 | 5;
  /** Load the car photo eagerly (above the fold). */
  priority?: boolean;
  /** Cycle through the five states on a fixed clock until the visitor taps. */
  autoplay?: boolean;
  class?: string;
}
const { static: isStatic = false, state: staticState = 4, priority = false, autoplay = false, class: className = '' } = Astro.props;
const stateNames = ['Parked', 'Get a text', 'Request received', 'Driver on the way', 'All done'];
const track = ['Requested', 'On it', 'Bringing', 'Outside'];
const hiddenIf = (n: number) => (isStatic ? n !== staticState : n !== 1);
---
<div class:list={['guest-phone flex flex-col items-center gap-6', className]} {...(isStatic ? {} : { 'data-guest': '' })} {...(autoplay ? { 'data-autoplay': '' } : {})}>
  <div class:list={['phone-frame w-full max-w-[360px]', !isStatic && 'phone-fit']}>
    <div class="phone-screen bg-field text-ink" {...(isStatic ? {} : { 'aria-live': 'polite' })}>
      {/* Header: car photo fading to the field */}
      <div class="absolute inset-x-0 top-0 h-[34%]">
        <Picture src={carGuest} formats={['avif', 'webp']} widths={[360, 720]} sizes="360px" alt="" class="guest-photo absolute inset-0 h-full w-full object-cover object-top" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
        <div class="absolute inset-x-0 top-0 flex items-start justify-between p-4">
          <span class="w-9"></span>
          <span class="t-wordmark shrink-0 whitespace-nowrap pt-1 text-[14px] text-white [text-shadow:0_1px_8px_rgba(0,0,0,.45)]">The Marquee</span>
          <span class="inline-flex items-center gap-1 rounded-pill bg-white/80 px-2.5 py-1 text-[11px] text-ink" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>
            عربي
          </span>
        </div>
      </div>

      {/* Panels */}
      <div class="absolute inset-x-0 bottom-0 top-[33%] flex flex-col px-5 pb-5 text-center" data-panels>
        {/* 1 PARKED */}
        <section data-state="1" class="flex h-full flex-col items-center" hidden={hiddenIf(1)}>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">Parked · 01:06 AM</p>
          <p class="mt-2 text-[26px] font-medium leading-tight tracking-[-0.02em]">Land Rover Defender</p>
          <div class="mt-3 flex items-center gap-2 text-[13px]">
            <Plate emirate="Dubai" code="M" number="95378" scale={0.62} />
            <span class="text-ink-3">·</span>
            <span class="text-ink-2">Ticket V777</span>
          </div>
          <p class="mt-3 text-[13px]"><span class="text-ink-3">Validation</span> <span class="ms-1 font-medium text-gold-text">Ask your server</span></p>
          <p class="mt-3 inline-flex items-center gap-1 text-[13px] text-ink-2" aria-hidden="true">Details <Icon name="chevron" size={14} /></p>
          <div class="mt-auto flex w-full flex-col items-center gap-3">
            <button type="button" class="btn-primary w-full !py-3.5 !text-[15px]" data-go="2">Request My Car</button>
            <span class="text-[13px] text-ink-2 underline underline-offset-2" aria-hidden="true">Show QR</span>
            <div class="flex w-full items-center gap-3 rounded-[14px] bg-white px-3.5 py-3 text-start text-[13px] shadow-[0_1px_2px_rgba(0,0,0,.04)]">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-field text-[13px] font-medium">M</span>
              <div class="min-w-0 flex-1"><p class="font-medium">Shift manager</p><p class="truncate text-[12px] text-ink-3">The Marquee · replies in a few minutes</p></div>
              <span class="inline-flex items-center gap-1 text-ink underline underline-offset-2">Message <Icon name="chevron" size={12} class="-rotate-90" /></span>
            </div>
          </div>
        </section>

        {/* 2 SHEET */}
        <section data-state="2" class="relative flex h-full flex-col" hidden={hiddenIf(2)}>
          <div class="pointer-events-none select-none opacity-30" aria-hidden="true">
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">Parked · 01:06 AM</p>
            <p class="mt-2 text-[26px] font-medium leading-tight tracking-[-0.02em]">Land Rover Defender</p>
          </div>
          <div class="sheet -mx-5 -mb-5 mt-auto rounded-t-[22px] bg-white px-5 pb-6 pt-4 text-start shadow-[0_-8px_30px_-20px_rgba(0,0,0,.25)]">
            <div class="mx-auto mb-4 h-1 w-9 rounded-pill bg-ink/15"></div>
            <p class="text-[20px] font-medium leading-tight tracking-[-0.01em]">Get a text when it’s ready</p>
            <p class="mt-2 text-[13px] leading-snug text-ink-2">We’ll text you when your car is on its way and when it’s at the door. No account, no spam.</p>
            <div class="mt-4 flex items-center gap-2 rounded-card border border-ink/15 bg-field px-3 py-2.5 text-[15px]" aria-hidden="true">
              <span class="text-ink-2">+971</span><span class="text-ink-3">58 ··· ····</span>
            </div>
            <button type="button" class="btn-primary mt-3 w-full !py-3.5 !text-[15px]" data-go="3">Text me when it’s ready</button>
            <button type="button" class="mt-3 w-full text-center text-[13px] text-ink-2 underline-offset-2 hover:underline" data-go="3">Skip, I’ll keep this page open</button>
          </div>
        </section>

        {/* 3 REQUEST RECEIVED */}
        <section data-state="3" class="flex h-full flex-col items-center" hidden={hiddenIf(3)}>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">Request received</p>
          <p class="mt-3 text-[64px] font-light leading-none tracking-[-0.03em]">5<span class="ms-2 text-[22px] font-normal tracking-normal text-ink-2">min</span></p>
          <p class="mt-3 text-[13px] text-ink-2">Finding your valet, usually under a minute</p>
          <ol class="mt-6 grid w-full grid-cols-4 gap-1.5" aria-label="Progress">
            {track.map((t, i) => (
              <li class="flex flex-col gap-2">
                <span class:list={['text-[11px]', i < 1 ? 'font-medium text-ink' : 'text-ink-3']}>{t}</span>
                <span class:list={['h-[2px] rounded-pill', i < 1 ? 'bg-ink' : 'bg-ink/10']}></span>
              </li>
            ))}
          </ol>
          <div class="mt-auto w-full">
            <button type="button" class="btn-ghost w-full bg-white" data-go="1">Cancel request</button>
          </div>
        </section>

        {/* 4 BRINGING */}
        <section data-state="4" class="flex h-full flex-col items-center" hidden={hiddenIf(4)}>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">Your driver is bringing your car</p>
          <p class="mt-2 text-[60px] font-light leading-none tracking-[-0.03em]">4<span class="ms-2 text-[20px] font-normal tracking-normal text-ink-2">min</span></p>
          <p class="mt-2 text-[12px] text-ink-2">Your driver is bringing your car to main entrance</p>
          <ol class="mt-3 grid w-full grid-cols-4 gap-1.5" aria-label="Progress">
            {track.map((t, i) => (
              <li class="flex flex-col gap-1.5">
                <span class:list={['text-[11px]', i < 3 ? 'font-medium text-ink' : 'text-ink-3']}>{t}</span>
                <span class:list={['h-[2px] rounded-pill', i < 3 ? 'bg-ink' : 'bg-ink/10']}></span>
              </li>
            ))}
          </ol>
          <div class="mt-3 flex w-full flex-col gap-2 text-start text-[13px]">
            <div class="flex items-center gap-3 rounded-[14px] bg-white px-3.5 py-2.5 shadow-[0_1px_2px_rgba(0,0,0,.04)]">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-ink text-[13px] font-medium text-white">Y</span>
              <div class="min-w-0 flex-1"><p class="font-medium">Your driver</p><p class="truncate text-[12px] text-ink-3">To the main entrance</p></div>
              <span class="underline underline-offset-2">Message</span>
            </div>
            <div class="flex items-center gap-3 rounded-[14px] bg-white px-3.5 py-2.5 shadow-[0_1px_2px_rgba(0,0,0,.04)]">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-field text-[13px] font-medium">M</span>
              <div class="min-w-0 flex-1"><p class="font-medium">Shift manager</p><p class="truncate text-[12px] text-ink-3">Replies in a few minutes</p></div>
              <span class="underline underline-offset-2">Message</span>
            </div>
          </div>
          <div class="mt-auto w-full">
            <div class="flex items-center gap-2" role="group" aria-label="Tip amount, AED">
              <span class="me-1 text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">Tip</span>
              {[20, 40, 80].map((v) => {
                const Tag = isStatic ? 'span' : 'button';
                return <Tag {...(isStatic ? {} : { type: 'button' })} class="flex-1 rounded-pill border border-ink/15 bg-white py-2.5 min-h-[32px] text-center text-[14px] font-medium transition-colors data-[on]:border-ink data-[on]:bg-ink data-[on]:text-white" data-tip={v} {...(v === 80 ? { 'data-on': '' } : {})}>{v}</Tag>;
              })}
            </div>
            {isStatic ? (
              <span class="btn-primary mt-2.5 w-full !py-3.5 !text-[15px]" aria-hidden="true"><Icon name="apple" size={16} /> Pay with Apple Pay</span>
            ) : (
              <button type="button" class="btn-primary mt-2.5 w-full !py-3.5 !text-[15px]" data-pay><Icon name="apple" size={16} /> Pay with Apple Pay</button>
            )}
          </div>
        </section>

        {/* 5 ALL DONE */}
        <section data-state="5" class="flex h-full flex-col items-center" hidden={hiddenIf(5)}>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-ink-2">All done</p>
          <span class="mt-3 inline-flex size-11 items-center justify-center rounded-full border border-gold text-gold"><Icon name="check" size={20} /></span>
          <p class="mt-2 text-[26px] font-medium leading-tight tracking-[-0.02em]">Safe travels</p>
          <p class="mt-2 text-[13px] text-ink-2"><span class="uppercase tracking-[0.14em] text-[11px] font-medium">Tip</span> <span class="ms-1 font-medium text-ink" data-tip-out>80</span> AED</p>
          <p class="mt-1 text-[12px] text-ink-3">Receipt sent to +971 58 ···· ····</p>
          <div class="mt-5">
            <p class="text-[14px] font-medium">How was it today?</p>
            <div class="mt-2 flex justify-center gap-1.5" role="group" aria-label="Rating">
              {[1, 2, 3, 4, 5].map((n) => {
                const Star = isStatic ? 'span' : 'button';
                return <Star {...(isStatic ? {} : { type: 'button', 'aria-label': `${n} star${n > 1 ? 's' : ''}` })} class="text-ink/15 data-[on]:text-gold" data-star={n} data-on=""><Icon name="star" size={22} class="fill-current" /></Star>;
              })}
            </div>
          </div>
          <div class="mt-auto flex w-full flex-col gap-2.5">
            <span class="btn-primary w-full !py-3.5 !text-[15px]" aria-hidden="true">Send rating</span>
            <span class="btn-ghost w-full bg-white" aria-hidden="true"><Icon name="download" size={15} /> Download receipt</span>
          </div>
        </section>
      </div>

      {/* Apple Pay sheet: slides up over the guest page, side-button hint, Face ID, Done. Interactive sample only. */}
      {!isStatic && (
        <div class="ap" data-applepay hidden aria-hidden="true">
          <div class="ap-dim"></div>
          <p class="ap-hint"><span>Double-click<br />to pay</span><i></i></p>
          <div class="ap-sheet">
            <div class="ap-head">
              <span class="ap-mark"><Icon name="apple" size={17} />Pay</span>
              <span class="ap-x" aria-hidden="true">×</span>
            </div>
            <div class="ap-row">
              <span class="ap-card"></span>
              <span class="ap-row-main"><b>Visa</b><small>•••• 4421</small></span>
              <span class="ap-chev">›</span>
            </div>
            <div class="ap-row">
              <span class="ap-row-label">Contact</span>
              <span class="ap-row-main"><small>+971 58 ···· ····</small></span>
              <span class="ap-chev">›</span>
            </div>
            <div class="ap-sum">
              <p><small>Tip · The Marquee valet</small><small>AED <span data-ap-amount>80</span>.00</small></p>
              <p class="ap-total"><span>Pay The Marquee</span><span>AED <span data-ap-amount>80</span>.00</span></p>
            </div>
            <div class="ap-confirm">
              <span class="ap-faceid" aria-hidden="true">
                <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path class="ap-fi-c" d="M4 13V9a5 5 0 0 1 5-5h4M27 4h4a5 5 0 0 1 5 5v4M36 27v4a5 5 0 0 1-5 5h-4M13 36H9a5 5 0 0 1-5-5v-4"/>
                  <path class="ap-fi-f" d="M14 15v3M26 15v3M20 15v8h-2M15 27c3 2.5 7 2.5 10 0"/>
                </svg>
                <svg class="ap-check" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="20" r="17"/><path d="M12.5 20.5l5 5 10-11"/></svg>
              </span>
              <span class="ap-status"><span class="ap-s1">Confirm with Side Button</span><span class="ap-s2">Face ID</span><span class="ap-s3">Done</span></span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  {/* Stepper + reset */}
  {!isStatic && <div class="flex w-full max-w-[360px] flex-col items-center gap-3">
    <div class="flex items-center gap-3">
      <button type="button" class="btn-ghost !p-2" data-prev aria-label="Previous state"><Icon name="arrow-left" size={16} /></button>
      <div class="flex items-center gap-2" role="tablist" aria-label="Guest page states">
        {stateNames.map((n, i) => (
          <button type="button" role="tab" class="group p-1" data-dot={i + 1} aria-label={`${i + 1}. ${n}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="block size-2 rounded-full bg-ink/15 transition-colors group-aria-selected:bg-ink"></span>
          </button>
        ))}
      </div>
      <button type="button" class="btn-ghost !p-2" data-next aria-label="Next state"><Icon name="arrow-right" size={16} /></button>
    </div>
    <div class="flex items-center gap-4">
      <button type="button" class="inline-flex items-center gap-1.5 text-[13px] text-ink-2 hover:text-ink" data-reset><Icon name="reset" size={14} /> Reset</button>
    </div>
    <p class="sr-only" data-announce></p>
  </div>}
</div>

<style>
  .guest-photo {
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
  }
  .plate { display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #0a0a0a; border-radius: 5px; padding: 2px 8px; font-weight: 600; font-size: 13px; letter-spacing: 0.04em; background: #fff; }
  .plate i { display: inline-block; width: 1.5px; height: 14px; background: #0a0a0a; }
  .sheet { animation: v-sheet 320ms cubic-bezier(.2,.8,.2,1) both; }
  @keyframes v-sheet { from { transform: translateY(24px); opacity: 0 } to { transform: none; opacity: 1 } }
  [data-state]:not([hidden]) { animation: v-fade-up 300ms ease both; }
  @media (prefers-reduced-motion: reduce) { .sheet, [data-state]:not([hidden]) { animation: none; } }

  /* Apple Pay sheet (light, iOS). Phases on [data-phase]: in → confirm → faceid → done → out. */
  .ap { position: absolute; inset: 0; z-index: 30; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; color: #000; }
  .ap[hidden] { display: none; }
  .ap-dim { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.32); opacity: 0; transition: opacity 280ms ease; }
  .ap-sheet { position: absolute; inset-inline: 6px; bottom: 6px; border-radius: 26px; background: #fff; padding: 14px 16px 18px; box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.12);
    transform: translateY(105%); transition: transform 420ms cubic-bezier(0.32, 0.72, 0, 1); }
  .ap-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 8px; }
  .ap-mark { display: inline-flex; align-items: center; gap: 1px; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .ap-mark :global(svg) { margin-top: -3px; }
  .ap-x { display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 999px; background: #eeeef0; color: #8a8a8e; font-size: 17px; line-height: 1; }
  .ap-row { display: flex; align-items: center; gap: 10px; border-top: 0.5px solid rgba(60, 60, 67, 0.18); padding: 10px 0; font-size: 13px; }
  .ap-card { width: 34px; height: 22px; flex-shrink: 0; border-radius: 4px; background: linear-gradient(135deg, #1a1f71 0%, #2b3a9c 60%, #f7b600 60% 66%, #2b3a9c 66%); }
  .ap-row-label { width: 34px; flex-shrink: 0; font-size: 11px; color: #8a8a8e; }
  .ap-row-main { display: flex; min-width: 0; flex: 1; flex-direction: column; line-height: 1.25; }
  .ap-row-main b { font-weight: 600; }
  .ap-row-main small, .ap-sum small { font-size: 12px; color: #6c6c70; }
  .ap-chev { color: #c4c4c7; font-size: 20px; line-height: 1; }
  .ap-sum { border-top: 0.5px solid rgba(60, 60, 67, 0.18); padding-top: 10px; }
  .ap-sum p { display: flex; justify-content: space-between; }
  .ap-total { margin-top: 4px; font-size: 15px; font-weight: 600; }
  .ap-confirm { display: flex; flex-direction: column; align-items: center; gap: 6px; padding-top: 16px; }
  .ap-faceid { position: relative; width: 40px; height: 40px; color: #8a8a8e; }
  .ap-faceid svg { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 220ms ease, transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ap-check { opacity: 0; transform: scale(0.6); color: #0a84ff; }
  .ap-check path, .ap-check circle { stroke-dasharray: 120; stroke-dashoffset: 120; transition: stroke-dashoffset 520ms cubic-bezier(0.65, 0, 0.35, 1); }
  .ap-status { position: relative; height: 16px; width: 100%; font-size: 13px; text-align: center; color: #3c3c43; }
  .ap-status > span { position: absolute; inset: 0; opacity: 0; transition: opacity 200ms ease; }
  .ap-hint { position: absolute; top: 16%; inset-inline-end: 0; z-index: 2; display: flex; align-items: center; gap: 6px; opacity: 0; transition: opacity 240ms ease;
    font: 600 11px/1.15 -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; color: #fff; text-align: end; }
  .ap-hint i { display: block; width: 4px; height: 44px; border-radius: 3px 0 0 3px; background: #fff; }
  .ap[data-phase] .ap-dim { opacity: 1; }
  .ap[data-phase] .ap-sheet { transform: none; }
  .ap[data-phase='confirm'] .ap-hint { opacity: 1; animation: ap-pulse 900ms ease-in-out infinite; }
  .ap[data-phase='confirm'] .ap-s1, .ap[data-phase='faceid'] .ap-s2, .ap[data-phase='done'] .ap-s3, .ap[data-phase='out'] .ap-s3 { opacity: 1; }
  .ap[data-phase='faceid'] .ap-faceid { color: #0a84ff; }
  .ap[data-phase='faceid'] .ap-faceid svg:first-child { animation: ap-scan 700ms ease-in-out infinite alternate; }
  .ap[data-phase='done'] .ap-faceid svg:first-child, .ap[data-phase='out'] .ap-faceid svg:first-child { opacity: 0; transform: scale(1.3); }
  .ap[data-phase='done'] .ap-check, .ap[data-phase='out'] .ap-check { opacity: 1; transform: none; }
  .ap[data-phase='done'] .ap-check path, .ap[data-phase='done'] .ap-check circle, .ap[data-phase='out'] .ap-check path, .ap[data-phase='out'] .ap-check circle { stroke-dashoffset: 0; }
  .ap[data-phase='done'] .ap-s3 { color: #0a84ff; font-weight: 600; }
  .ap[data-phase='out'] .ap-dim { opacity: 0; }
  .ap[data-phase='out'] .ap-sheet { transform: translateY(105%); }
  @keyframes ap-pulse { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-4px); } }
  @keyframes ap-scan { from { transform: scale(1); } to { transform: scale(0.9); } }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const names = ['Parked', 'Get a text when it’s ready', 'Request received', 'Your driver is bringing your car', 'All done'];

  document.querySelectorAll<HTMLElement>('[data-guest]').forEach((root) => {
    const panels = root.querySelectorAll<HTMLElement>('[data-state]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-dot]');
    const announce = root.querySelector<HTMLElement>('[data-announce]');
    let state = 1;
    let timer: number | undefined;
    let loop: number | undefined;
    let tip = 80;
    const autoplay = 'autoplay' in root.dataset;
    let interacted = false;
    let visible = true;

    const show = (n: number, { auto = true } = {}) => {
      state = Math.min(5, Math.max(1, n));
      panels.forEach((p) => { p.hidden = Number(p.dataset.state) !== state; });
      dots.forEach((d) => d.setAttribute('aria-selected', Number(d.dataset.dot) === state ? 'true' : 'false'));
      if (announce) announce.textContent = `Guest page: ${names[state - 1]}`;
      window.clearTimeout(timer); window.clearTimeout(loop);
      // Deterministic auto-advance: request received → driver assigned after 2.4 s.
      if (auto && !reduce && state === 3) timer = window.setTimeout(() => show(4), 2400);
      // Autoplay (hero): walk through the five states on a fixed clock until the visitor taps.
      else if (autoplay && !reduce && !interacted && visible) loop = window.setTimeout(() => show(state === 5 ? 1 : state + 1), state === 4 ? 3600 : 2800);
    };
    const syncTip = () => {
      root.querySelectorAll<HTMLElement>('[data-tip]').forEach((b) => { if (Number(b.dataset.tip) === tip) b.setAttribute('data-on', ''); else b.removeAttribute('data-on'); });
      const out = root.querySelector('[data-tip-out]'); if (out) out.textContent = String(tip);
    };
    const syncStars = (n: number) => {
      root.querySelectorAll<HTMLElement>('[data-star]').forEach((s) => { if (Number(s.dataset.star) <= n) s.setAttribute('data-on', ''); else s.removeAttribute('data-on'); });
    };

    // Apple Pay: sheet up, side-button hint, Face ID, Done, sheet away, then "All done". Reduced motion: straight to done.
    const ap = root.querySelector<HTMLElement>('[data-applepay]');
    let apTimers: number[] = [];
    const apStop = () => { apTimers.forEach((x) => window.clearTimeout(x)); apTimers = []; if (ap) { ap.hidden = true; ap.removeAttribute('data-phase'); } };
    const pay = () => {
      if (!ap || reduce) { show(5); return; }
      apStop();
      ap.querySelectorAll('[data-ap-amount]').forEach((el) => { el.textContent = String(tip); });
      ap.hidden = false;
      const at = (ms: number, fn: () => void) => apTimers.push(window.setTimeout(fn, ms));
      requestAnimationFrame(() => requestAnimationFrame(() => ap.setAttribute('data-phase', 'in')));
      at(650, () => ap.setAttribute('data-phase', 'confirm'));
      at(2050, () => ap.setAttribute('data-phase', 'faceid'));
      at(2900, () => ap.setAttribute('data-phase', 'done'));
      at(3900, () => ap.setAttribute('data-phase', 'out'));
      at(4350, () => { apStop(); show(5); });
    };

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-go],[data-dot],[data-prev],[data-next],[data-reset],[data-tip],[data-star],[data-pay]');
      if (!t || !root.contains(t)) return;
      interacted = true; window.clearTimeout(loop);
      if ('pay' in t.dataset) { pay(); return; }
      apStop();
      if (t.dataset.go) show(Number(t.dataset.go));
      else if (t.dataset.dot) show(Number(t.dataset.dot));
      else if ('prev' in t.dataset) show(state - 1);
      else if ('next' in t.dataset) show(state + 1);
      else if ('reset' in t.dataset) { tip = 80; syncTip(); syncStars(5); show(1, { auto: false }); }
      else if (t.dataset.tip) { tip = Number(t.dataset.tip); syncTip(); }
      else if (t.dataset.star) syncStars(Number(t.dataset.star));
    });

    if (autoplay && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((en) => { visible = en.isIntersecting; if (visible && !interacted) show(state); else window.clearTimeout(loop); });
      }, { threshold: 0.3 }).observe(root);
    }
    // Reduced motion: render the final state first.
    show(reduce ? 5 : 1, { auto: false });
  });
</script>
