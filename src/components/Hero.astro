---
import Film from './Film.astro';
import HeroStage from './HeroStage.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
const hasFilm = Boolean(site.film.mp4);
---
<section class="pt-20 pb-28 md:pt-36 md:pb-48" aria-labelledby="hero-title">
  <div class="container-page flex flex-col items-center text-center">
    <Wordmark class="text-[20px] text-ink md:text-[24px]" />
    <h1 id="hero-title" class="t-display mt-10 max-w-[10em] md:mt-14 lg:!text-[112px]" style="text-wrap: balance">{site.slogan}</h1>
    <p class="mt-8 text-[18px] text-ink-2 md:mt-10 md:text-[22px]">Valet management for Dubai’s best venues.</p>
    <a href="#demo" class="btn-primary mt-10 md:mt-12 md:!px-8 md:!py-4 md:!text-[17px]">Book a demo</a>
    {hasFilm ? <Film variant="hero" priority class="mt-20 w-full max-w-[1100px] md:mt-28" /> : <HeroStage />}
  </div>
</section>
