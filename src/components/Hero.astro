---
import Film from './Film.astro';
import HeroScreens from './HeroScreens.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
const hasFilm = Boolean(site.film.mp4);
const lines = [
  'Every car photographed before it moves',
  'Every guest reachable without an app',
  'Every incident traceable',
];
---
<section class="pt-10 pb-20 md:pt-16 md:pb-32" aria-labelledby="hero-title">
  <div class="container-page">
    <div class:list={['grid gap-12 lg:gap-10', hasFilm ? 'justify-items-center text-center' : 'items-center lg:grid-cols-12']}>
      <div class:list={['flex flex-col', hasFilm ? 'items-center' : 'items-start text-start lg:col-span-7 lg:pe-10']}>
        <Wordmark class="text-[22px] text-ink md:text-[26px]" />
        <h1 id="hero-title" class="mt-8 max-w-[9.5em] text-[48px] font-medium leading-[1.04] tracking-[-0.03em] md:mt-10 md:text-[64px] xl:text-[80px]" style="text-wrap: balance">{site.slogan}</h1>
        <p class="t-body measure mt-7 text-ink-2 md:text-[20px]">
          One record of every car, from the first photo to the last text. Built for the venues guests remember.
        </p>
        <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
          <a href="#demo" class="btn-primary">Book a demo</a>
          <a href="#why" class="btn-link">Watch the film <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      {hasFilm ? (
        <Film variant="hero" priority class="w-full max-w-[1200px]" />
      ) : (
        <div class="lg:col-span-5"><HeroScreens /></div>
      )}
    </div>
    <ul class="mt-14 grid grid-cols-1 gap-y-0 md:mt-20 md:grid-cols-3 md:gap-x-10">
      {lines.map((l) => (
        <li class="hairline-t py-5 text-[15px] text-ink-2 md:text-[16px]">{l}</li>
      ))}
    </ul>
  </div>
</section>
