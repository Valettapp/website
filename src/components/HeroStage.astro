---
/**
 * Hero showcase: three phones fanned in a large rounded panel (centre: guest page, sides: staff app),
 * two glass cards echoing the centre screen. Scroll-driven fan-out and pointer tilt via CSS variables;
 * static defaults render the finished composition without JS or under reduced motion.
 */
import GuestPhone from './GuestPhone.astro';
import StaffScreen from './StaffScreen.astro';
import Icon from './Icon.astro';
---
<div class="hero-stage relative mx-auto mt-16 w-full max-w-[1100px] md:mt-20" data-hero-stage style="--enter:1;--leave:0;--tx:0deg;--ty:0deg;--mx:0;--my:0">
  <div class="relative overflow-hidden rounded-[32px] bg-field aspect-[4/5] sm:aspect-[16/11] lg:aspect-[16/10] md:rounded-[40px]" style="perspective: 1600px">
    <div class="fan absolute inset-x-0 top-[8%] flex items-start justify-center">
      <div class="fan-side fan-left w-[300px] shrink-0" aria-hidden="true"><StaffScreen screen="request" /></div>
      <div class="fan-centre relative z-10 w-[360px] shrink-0"><div class="hero-phone-tilt"><GuestPhone static priority /></div></div>
      <div class="fan-side fan-right w-[300px] shrink-0" aria-hidden="true"><StaffScreen screen="ticket" /></div>
    </div>

    {/* Glass cards echoing the centre screen */}
    <div class="glass-card hero-card absolute end-[2%] top-[3%] z-20 flex w-[196px] items-center gap-2.5 px-3.5 py-2.5 text-start text-[12px] sm:w-[256px] sm:gap-3 sm:px-4 sm:py-3 sm:text-[13px] md:end-[7%] md:top-[14%]" style="--speed:1" aria-hidden="true">
      <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-gold text-gold"><Icon name="sms" size={15} /></span>
      <span class="min-w-0"><strong class="block font-semibold">Text from The Marquee</strong><span class="block text-ink-2">Your driver is bringing your car. 4 min.</span></span>
    </div>
    <div class="glass-card hero-card absolute start-[2%] top-[66%] z-20 flex w-[196px] items-center gap-2.5 px-3.5 py-2.5 text-start text-[12px] sm:w-[256px] sm:gap-3 sm:px-4 sm:py-3 sm:text-[13px] md:start-[7%] md:top-[62%]" style="--speed:1.4" aria-hidden="true">
      <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-ink text-white"><Icon name="bolt" size={15} /></span>
      <span class="min-w-0"><strong class="block font-semibold">Driver on it</strong><span class="block text-ink-2">Zone P3 · Bay 55 · keys from hook 55</span></span>
    </div>
  </div>
</div>

<style>
  /* Phone scale per breakpoint: zoom the wrappers so layout width scales with the screens. */
  .fan-centre { zoom: 0.6; }
  .fan-side { zoom: 0.44; margin-inline: -95px; }
  @media (min-width: 40rem) { .fan-centre { zoom: 0.9; } .fan-side { zoom: 0.72; margin-inline: -100px; } }
  @media (min-width: 64rem) { .fan-centre { zoom: 1; } .fan-side { zoom: 0.86; margin-inline: -66px; } }

  .hero-stage :global(.phone-frame) { box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 60px 120px -50px rgba(0,0,0,.32); }

  /* Scroll-driven: side phones fan out from behind the centre as the panel enters; the fan tips back on exit. */
  .fan { transform: rotateX(calc(var(--leave) * 10deg)); transform-origin: 50% 0; transform-style: preserve-3d; will-change: transform; }
  .fan-centre { transform: translateY(calc((1 - var(--enter)) * 90px)) scale(calc(0.94 + var(--enter) * 0.06)); transform-origin: 50% 0; will-change: transform; }
  .fan-left  { transform: translate3d(calc((1 - var(--enter)) * 120px), calc(56px + (1 - var(--enter)) * 90px), -80px) rotateY(12deg); transform-origin: 100% 0; will-change: transform; }
  .fan-right { transform: translate3d(calc((1 - var(--enter)) * -120px), calc(56px + (1 - var(--enter)) * 90px), -80px) rotateY(-12deg); transform-origin: 0 0; will-change: transform; }
  .hero-phone-tilt { transform: rotateX(var(--tx)) rotateY(var(--ty)); transform-style: preserve-3d; transition: transform 240ms cubic-bezier(.2,.8,.2,1); will-change: transform; }
  .hero-card {
    transform: translateY(calc((1 - var(--enter)) * var(--speed) * 120px)) translate(calc(var(--mx) * var(--speed) * -14px), calc(var(--my) * var(--speed) * -10px));
    transition: transform 240ms cubic-bezier(.2,.8,.2,1); will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .fan, .fan-centre, .hero-phone-tilt, .hero-card { transform: none !important; transition: none !important; }
    .fan-left { transform: translate3d(0, 56px, -80px) rotateY(12deg) !important; }
    .fan-right { transform: translate3d(0, 56px, -80px) rotateY(-12deg) !important; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hero-stage]').forEach((stage) => {
    if (reduce) return;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = stage.getBoundingClientRect();
      const vh = window.innerHeight;
      stage.style.setProperty('--enter', clamp((vh - r.top) / (vh * 0.6)).toFixed(3));
      stage.style.setProperty('--leave', clamp(-r.top / (r.height * 0.9)).toFixed(3));
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const reset = () => ['--tx', '--ty'].forEach((k) => stage.style.setProperty(k, '0deg')) && ['--mx', '--my'].forEach((k) => stage.style.setProperty(k, '0'));
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--tx', `${(-y * 8).toFixed(2)}deg`);
        stage.style.setProperty('--ty', `${(x * 10).toFixed(2)}deg`);
        stage.style.setProperty('--mx', x.toFixed(3));
        stage.style.setProperty('--my', y.toFixed(3));
      });
      stage.addEventListener('pointerleave', () => { stage.style.setProperty('--tx', '0deg'); stage.style.setProperty('--ty', '0deg'); stage.style.setProperty('--mx', '0'); stage.style.setProperty('--my', '0'); });
    }
  });
</script>
