---
/**
 * HeroStory — the pinned, scroll-driven hero. The section is ~3.6 screens tall; a sticky stage
 * holds while scrolling drives one phone through the Valett story in four beats:
 *   0  Headline.                         1  Photograph: the staff camera reads the plate.
 *   2  The guest's ticket, from the QR.   3  Request from the table, driver on it.
 *   4  Safe travels: rate, tip, receipt.
 * Scroll progress (0–1) is read from the section's position each frame; every element with
 * data-win / data-in / data-out gets an eased 0–1 variable for its own window. No JS or
 * reduced motion → the story renders as a static page (headline, phone on beat 3, four captions).
 */
import { Picture } from 'astro:assets';
import carScan from '../assets/car-scan.jpg';
import GuestPhone from './GuestPhone.astro';
import StaffScreen from './StaffScreen.astro';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Plate from './Plate.astro';
import Ambient from './Ambient.astro';
import { site } from '../data/site';

const beats = [
  { n: '01', where: 'At the door', title: 'One photo. Plate, make, model and colour.', body: 'The valet photographs the car. Nothing typed, nothing written down.', in: '0.14,0.20', out: '0.40,0.45' },
  { n: '02', where: 'On the guest’s phone', title: 'A ticket from the QR. Nothing to download.', body: 'The car’s photo, the ticket and the validation, in English or Arabic. No account.', in: '0.46,0.52', out: '0.59,0.64' },
  { n: '03', where: 'From the table', title: 'Request from the table. Watch the car come.', body: 'The driver taps once and the guest’s page moves. Every minute on the record.', in: '0.65,0.71', out: '0.79,0.84' },
  { n: '04', where: 'At the kerb', title: 'Rate, tip and receipt. By text.', body: 'The wait is the last thing a guest remembers. Now it is a text.', in: '0.85,0.91', out: '' },
];
const fields = [['Make', 'Land Rover'], ['Model', 'Defender'], ['Colour', 'White']];
---
{/* Runs before the section is parsed, so the pinned layout is in place at first paint (no layout shift). */}
<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var html = document.documentElement;
    html.classList.add('story-on');
    // Browsers with scroll-driven animations (Chromium 115+, Safari 26+) run the story on the compositor from a root
    // scroll timeline; the ranges need the section's top offset, measured by the main script.
    if (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll(root)') && CSS.supports('animation-range: calc(1px + 1svh) 2px')) html.classList.add('story-sda');
    // Every length the story depends on (stage height, scroll length, phone scale) is fixed in px here, once.
    // iOS resizes the viewport while the address bar collapses mid-scroll; anything tied to the live viewport
    // height would jump at that moment. Re-measured only when the width changes (rotation).
    var lastW = 0;
    function measure() {
      var w = window.innerWidth;
      if (w === lastW) return;
      lastW = w;
      var probe = document.createElement('div');
      probe.style.cssText = 'position:fixed;top:0;left:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
      document.body.appendChild(probe);
      var vh = Math.max(560, probe.offsetHeight || window.innerHeight);
      probe.remove();
      var desktop = window.matchMedia('(min-width: 64rem)').matches;
      var ps = Math.max(0.42, Math.min(1, (desktop ? (vh - 200) / 740 : Math.min((w - 32) / 744, vh * 0.5 / 740))));
      html.style.setProperty('--story-vh', vh + 'px');
      html.style.setProperty('--story-ps', ps.toFixed(3));
      html.style.setProperty('--story-inv', (1 / ps).toFixed(4));
    }
    measure();
    window.addEventListener('resize', measure);
  })();
</script>
<section class="hero-story relative" data-story style="--ps:var(--story-ps, 1)" aria-labelledby="hero-title">
  <div class="story-stage relative">
    <Ambient variant="hero" />
    <div class="story-body container-page relative h-full">

      {/* Beat 0: headline */}
      <div class="story-intro z-20 flex flex-col items-center text-center" data-win="0,0.12" data-off-at="end">
        <h1 id="hero-title" class="t-display max-w-[10em] lg:!text-[104px]" style="text-wrap: balance">{site.slogan}</h1>
        <p class="mt-6 max-w-[26em] text-[17px] leading-relaxed text-ink-2 md:mt-8 md:text-[21px]">Valet management for Dubai’s best venues. One record of every car, from the first photo to the last text.</p>
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:gap-4 md:mt-10">
          <a href="#demo" class="btn-primary md:!px-7 md:!py-3.5 md:!text-[16px]">Book a demo</a>
          <a href="#how" class="btn-ghost glass !px-6 !py-3.5 !text-[15px] md:!text-[16px]">See how it works</a>
        </div>
        <p class="story-hint mt-10 inline-flex items-center gap-2 text-[12px] uppercase tracking-[0.14em] text-ink-3 md:mt-14" aria-hidden="true"><Icon name="chevron" size={14} /> Scroll to see it work</p>
      </div>

      {/* Rounded glass panel behind the fan */}
      <div class="story-panel glass-panel" data-win="0.02,0.18" aria-hidden="true"></div>

      {/* The phones and their floating cards share one transform (position + scale) */}
      <div class="story-hub z-10" data-win="0.02,0.18">
        {/* Side phones: the staff app, fanned out behind the guest's phone (same composition on mobile) */}
        <div class="story-side story-side-l" aria-hidden="true" inert><StaffScreen screen="request" /></div>
        <div class="story-side story-side-r" aria-hidden="true" inert><StaffScreen screen="ticket" /></div>
        <div class="story-phone relative w-[360px]" role="img" aria-label="One phone walking through Valett: the staff camera reads the plate from a photo; the guest's ticket appears on their phone; they request the car from the table and watch the driver come; they rate, tip and get a receipt by text.">
          {/* Screen 1: staff camera, scan driven by scroll */}
          <div class="story-screen phone-frame" data-screen="1" data-in="-0.2,-0.1" data-out="0.43,0.51" aria-hidden="true" inert>
            <div class="scan phone-screen bg-ink text-white">
              <div class="scan-feed-wrap absolute inset-0" data-win="0.33,0.41">
                <Picture src={carScan} formats={['avif', 'webp']} widths={[380, 760]} sizes="360px" alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
                {/* Viewfinder and plate box ride with the feed; the box sits on the measured plate (20–80 % × 54.7–62 %) */}
                <div class="scan-frame absolute left-[8%] right-[8%] top-[43%] z-10 aspect-[4/3]">
                  <div class="scan-corners absolute inset-0"></div>
                  <div class="scan-line absolute inset-x-2 top-0 h-px bg-gold/90 shadow-[0_0_14px_2px_rgba(197,162,83,.55)]" data-win="0.15,0.31"></div>
                </div>
                <div class="scan-plate absolute left-[18.5%] top-[53%] z-10 h-[10.5%] w-[63%] rounded-[4px] border-2 border-white/70" data-win="0.29,0.34">
                  <span class="absolute -top-6 right-0 rounded-[4px] bg-gold px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink">Plate</span>
                </div>
              </div>
              <div class="scan-shade absolute inset-0"></div>
              <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-5 pt-5">
                <Wordmark variant="serif" class="text-[12px] text-white/90" />
                <span class="text-[11px] text-white/70">01:05</span>
              </div>
              <div class="absolute inset-x-5 top-[77%] z-10 text-center">
                <div class="scan-t0" data-win="0.12,0.16">
                  <p class="text-[15px] font-medium drop-shadow">Take vehicle photo</p>
                  <p class="mt-1 text-[12px] text-white/70">Frame the number plate</p>
                </div>
                <p class="scan-t1 text-[15px] font-medium" data-in="0.13,0.17" data-out="0.30,0.34"><span class="inline-flex items-center gap-2"><span class="size-1.5 rounded-full bg-gold"></span>Scanning vehicle…</span></p>
              </div>
              <div class="scan-results absolute inset-x-0 bottom-0 z-10 rounded-t-[22px] bg-ink/95 px-5 pb-5 pt-4" data-win="0.33,0.41">
                <div class="mx-auto mb-3 h-1 w-9 rounded-pill bg-white/20"></div>
                <ul class="flex flex-col gap-1.5 text-[12px]">
                  <li class="flex items-center justify-between rounded-[8px] border border-white/10 bg-white/[.06] px-3 py-2"><span class="text-white/55">Plate</span><Plate emirate="Dubai" code="M" number="95378" scale={0.55} /></li>
                  {fields.map(([k, v]) => <li class="flex items-center justify-between rounded-[8px] border border-white/10 bg-white/[.06] px-3 py-2"><span class="text-white/55">{k}</span><span class="font-medium tracking-[0.02em]">{v}</span></li>)}
                </ul>
                <span class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-pill bg-white px-4 py-2.5 text-[13px] font-medium text-ink"><Icon name="check" size={13} /> Vehicle recognised · Continue</span>
              </div>
              <div class="scan-shutter absolute inset-x-0 bottom-5 z-10 flex justify-center" data-win="0.12,0.16">
                <span class="inline-flex size-14 items-center justify-center rounded-full border-2 border-white/90"><span class="size-11 rounded-full bg-white/95"></span></span>
              </div>
            </div>
          </div>
          {/* Screens 2–4: the guest page */}
          <div class="story-screen" data-screen="2" data-in="0.43,0.51" data-out="0.62,0.70" aria-hidden="true" inert><GuestPhone static state={1} /></div>
          <div class="story-screen" data-screen="3" data-in="0.62,0.70" data-out="0.82,0.90" aria-hidden="true" inert><GuestPhone static state={4} /></div>
          <div class="story-screen" data-screen="4" data-in="0.82,0.90" aria-hidden="true" inert><GuestPhone static state={5} /></div>
        </div>

        {/* Floating glass cards, one or two per beat */}
        <div class="story-card glass-card story-card-a" data-in="0.36,0.42" data-out="0.43,0.51" aria-hidden="true">
          <span class="story-card-icon border border-gold text-gold"><Icon name="check" size={14} /></span>
          <span class="min-w-0"><strong class="block font-semibold">Vehicle recognised</strong><span class="block text-ink-2">Land Rover Defender · White · M 95378</span></span>
        </div>
        <div class="story-card glass-card story-card-b" data-in="0.50,0.56" data-out="0.62,0.70" aria-hidden="true">
          <span class="story-card-icon border border-gold text-gold"><Icon name="sms" size={14} /></span>
          <span class="min-w-0"><strong class="block font-semibold">Text from The Marquee</strong><span class="block text-ink-2">Your car is parked. Ticket V777.</span></span>
        </div>
        <div class="story-card glass-card story-card-c" data-in="0.69,0.75" data-out="0.82,0.90" aria-hidden="true">
          <span class="story-card-icon bg-ink text-white"><Icon name="bolt" size={14} /></span>
          <span class="min-w-0"><strong class="block font-semibold">Driver on it</strong><span class="block text-ink-2">Zone P3 · Bay 55 · keys from hook 55</span></span>
        </div>
        <div class="story-card glass-card story-card-d" data-in="0.74,0.80" data-out="0.82,0.90" aria-hidden="true">
          <span class="story-card-icon border border-gold text-gold"><Icon name="sms" size={14} /></span>
          <span class="min-w-0"><strong class="block font-semibold">Text from The Marquee</strong><span class="block text-ink-2">Your driver is bringing your car. 4 min.</span></span>
        </div>
        <div class="story-card glass-card story-card-e" data-in="0.90,0.96" aria-hidden="true">
          <span class="story-card-icon border border-gold text-gold"><Icon name="star" size={14} class="fill-current" /></span>
          <span class="min-w-0"><strong class="block font-semibold">Receipt sent</strong><span class="block text-ink-2">AED 80 tip · 5 stars · +971 58 ···· ····</span></span>
        </div>
      </div>

      {/* Captions, one per beat */}
      <div class="story-captions z-10">
        {beats.map((b, i) => (
          <div class="story-cap" data-in={b.in} {...(b.out ? { 'data-out': b.out } : {})}>
            <p class="t-eyebrow"><span class="text-gold-text">{b.n}</span> · {b.where}</p>
            <h2 class="mt-3 text-[26px] font-semibold leading-[1.1] tracking-[-0.03em] md:text-[34px] lg:text-[40px]" style="text-wrap: balance">{b.title}</h2>
            <p class="mt-3 max-w-[24em] text-[15px] leading-relaxed text-ink-2 md:text-[17px]">{b.body}</p>
            {i === beats.length - 1 && <a href="#demo" class="btn-primary mt-6 md:!px-7 md:!py-3.5 md:!text-[16px]">Book a demo</a>}
          </div>
        ))}
        <ol class="story-dots" aria-hidden="true">{beats.map(() => <li></li>)}</ol>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- Static layout (no JS, or reduced motion): one page, phone on beat 3 ---------- */
  .hero-story { padding-block: 96px 64px; }
  .story-stage { height: auto; }
  .story-body { display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .story-intro .story-hint { display: none; }
  .story-hub { position: relative; width: 360px; max-width: 100%; }
  .story-phone > .story-screen { display: none; }
  .story-phone > .story-screen[data-screen="3"] { display: block; }
  .story-card { display: none; }
  .story-side { display: none; }
  .story-panel { display: none; }
  .story-captions { display: grid; gap: 40px; width: 100%; max-width: 980px; }
  .story-dots { display: none; }
  @media (min-width: 48rem) { .story-captions { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .story-cap .btn-primary { display: none; } }

  /* ---------- Scroll-driven story (html.story-on, set by the script) ---------- */
  html.story-on .hero-story { height: 560svh; height: calc(var(--story-vh, 100svh) * 5.6); padding: 0; }
  html.story-on .story-stage { position: sticky; top: 0; height: 100vh; height: 100svh; height: var(--story-vh, 100svh); min-height: 560px; overflow: hidden; }
  html.story-on .story-body { display: block; height: 100%; }
  html.story-on .story-intro { position: absolute; inset-inline: 0; top: 13%; display: flex; }
  html.story-on .story-intro .story-hint { display: inline-flex; }
  html.story-on .story-intro .story-hint svg { transform: rotate(0deg); animation: story-nudge 1.8s ease-in-out infinite; }
  html.story-on .story-hub { position: absolute; left: 50%; top: 50%; width: 360px; transform-origin: 50% 50%; }
  html.story-on .story-phone > .story-screen { display: block; }
  html.story-on .story-card { display: flex; }
  html.story-on .story-panel { display: block; position: absolute; border-radius: 32px; opacity: 0; will-change: transform, opacity; }
  html.story-on .story-side { display: block; position: absolute; top: 0; left: 50%; width: 300px; margin-inline-start: -150px; z-index: 0; will-change: transform, opacity; }
  html.story-on .story-phone { z-index: 1; }
  html.story-on .story-hub { perspective: 1400px; }
  html.story-on .story-side { opacity: 0; }
  html.story-on .story-side .phone-frame { box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 40px 80px -40px rgba(0,0,0,.3); }
  html.story-on .story-captions { position: absolute; display: block; max-width: none; }
  html.story-on .story-dots { display: flex; }
  html.story-on [data-off] { visibility: hidden; }

  /* Intro fades up and out as the phone arrives (styles written by the script) */
  html.story-on .story-intro { will-change: transform, opacity; }

  /* Hub: starts low and small (peeking under the headline), settles into its slot */
  html.story-on .story-hub { transform: translate(-50%, -50%) scale(var(--ps)); will-change: transform; }
  /* Frosted glass on the moving phones is what makes phones stutter: the panel behind keeps the frost, the frames go solid */
  html.story-on .story-hub .phone-frame { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(255, 255, 255, 0.84); }
  /* Touch devices: the frosted panel and cards go translucent-flat (the ambient behind is already soft), so the compositor never re-blurs while scrolling */
  @media (hover: none) {
    html.story-on .story-panel { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(255, 255, 255, 0.62); }
    html.story-on .story-card { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(255, 255, 255, 0.9); }
    html.story-on .story-hub { perspective: none; }
  }
  /* Phone screens stack; each crossfades on its own window */
  html.story-on .story-screen { position: absolute; inset: 0; will-change: transform, opacity; }
  html.story-on .story-screen[data-screen="1"] { position: relative; }
  html.story-on .story-screen .guest-phone { gap: 0; }

  /* Scan internals */
  .hero-story .scan-shade { pointer-events: none; background: linear-gradient(to bottom, rgba(0,0,0,.2), rgba(0,0,0,0) 30%, rgba(0,0,0,0) 62%, rgba(10,10,10,.92) 84%, #0a0a0a 100%); }
  .hero-story .scan-corners { background:
    linear-gradient(#fff,#fff) top left/22px 2px no-repeat, linear-gradient(#fff,#fff) top left/2px 22px no-repeat,
    linear-gradient(#fff,#fff) top right/22px 2px no-repeat, linear-gradient(#fff,#fff) top right/2px 22px no-repeat,
    linear-gradient(#fff,#fff) bottom left/22px 2px no-repeat, linear-gradient(#fff,#fff) bottom left/2px 22px no-repeat,
    linear-gradient(#fff,#fff) bottom right/22px 2px no-repeat, linear-gradient(#fff,#fff) bottom right/2px 22px no-repeat; }
  html.story-on .hero-story .scan-feed-wrap { transform: translateY(calc(var(--t, 0) * -22%)); will-change: transform; }
  html.story-on .hero-story .scan-line { opacity: calc(min(var(--t, 0), 1 - var(--t, 0)) * 4); top: calc(var(--t, 0) * 96%); }
  html.story-on .hero-story .scan-plate { opacity: var(--t, 0); transform: scale(calc(1.08 - var(--t, 0) * 0.08)); border-color: #c5a253; box-shadow: 0 0 0 2px rgba(197,162,83,.25), 0 0 24px rgba(197,162,83,.35); }
  html.story-on .hero-story .scan-t0 { opacity: calc(1 - var(--t, 0)); }
  html.story-on .hero-story .scan-t1 { opacity: calc(var(--in, 0) * (1 - var(--out, 0))); position: absolute; inset-inline: 0; top: 0; }
  html.story-on .hero-story .scan-results { transform: translateY(calc((1 - var(--t, 0)) * 100%)); will-change: transform; }
  html.story-on .hero-story .scan-shutter { opacity: calc(1 - var(--t, 0)); transform: translateY(calc(var(--t, 0) * 24px)); }
  /* Static: show the scan screen finished */
  html:not(.story-on) .hero-story .scan-feed-wrap { transform: translateY(-22%); }
  html:not(.story-on) .hero-story .scan-line, html:not(.story-on) .hero-story .scan-t0, html:not(.story-on) .hero-story .scan-t1, html:not(.story-on) .hero-story .scan-shutter { display: none; }

  /* Cards: counter-scaled so they keep their natural size whatever the phone scale */
  .story-card { position: absolute; width: 256px; align-items: center; gap: 12px; padding: 12px 16px; font-size: 13px; line-height: 1.35; text-align: start; }
  .story-card-icon { display: inline-flex; width: 32px; height: 32px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 9999px; }
  html.story-on .story-card { opacity: 0; will-change: transform, opacity; }
  .story-card-a { right: -210px; top: 12%; transform-origin: 100% 0; }
  .story-card-b { left: -220px; bottom: 18%; transform-origin: 0 100%; }
  .story-card-c { left: -230px; bottom: 26%; transform-origin: 0 100%; }
  .story-card-d { right: -220px; top: 9%; transform-origin: 100% 0; }
  .story-card-e { right: -210px; bottom: 20%; transform-origin: 100% 100%; }

  /* Captions */
  html.story-on .story-cap { position: absolute; inset-inline: 0; top: 0; opacity: 0; will-change: transform, opacity; }
  .story-dots { gap: 6px; }
  .story-dots li { width: 22px; height: 3px; border-radius: 999px; background: rgba(0,0,0,.1); transition: background 240ms ease; }
  .story-dots[data-beat="1"] li:nth-child(1), .story-dots[data-beat="2"] li:nth-child(2), .story-dots[data-beat="3"] li:nth-child(3), .story-dots[data-beat="4"] li:nth-child(4) { background: var(--color-gold); }
  html.story-on .story-dots { position: absolute; opacity: 0; }

  /* Mobile composition: phone top-centred, captions at the bottom */
  html.story-on .story-hub { top: calc(88px + 370px * var(--ps)); }
  html.story-on .story-panel { inset-inline: 12px; top: 68px; height: calc(790px * var(--ps) + 48px); }
  html.story-on .story-captions { inset-inline: 0; top: calc(68px + 790px * var(--ps) + 48px + 28px); text-align: center; }
  html.story-on .story-cap { display: flex; flex-direction: column; align-items: center; top: 0; }
  html.story-on .story-dots { left: 50%; top: 190px; transform: translateX(-50%); }
  @media (max-width: 63.98rem) {
    .story-card { width: 150px; font-size: 11px; line-height: 1.3; padding: 8px 10px; gap: 8px; border-radius: 12px; }
    .story-card .story-card-icon { width: 24px; height: 24px; }
    .story-card-a, .story-card-d, .story-card-e { right: auto; left: calc(100% - 64px); transform-origin: 0 50%; }
    .story-card-b, .story-card-c { left: auto; right: calc(100% - 64px); transform-origin: 100% 50%; }
    .story-card-a { top: 8%; } .story-card-d { top: 10%; } .story-card-e { bottom: 24%; }
    .story-card-b { bottom: 20%; } .story-card-c { bottom: 22%; }
    .story-card-a { top: 6%; }
    .story-card-b { bottom: 6%; }
    .story-card-c { bottom: 22%; }
    .story-card-d { top: 4%; }
    .story-card-e { bottom: 8%; }
  }
  /* Desktop composition: captions left, phone right of centre */
  @media (min-width: 64rem) {
    html.story-on .story-intro { top: 18%; }
    html.story-on .story-hub { top: 53%; }
    html.story-on .story-panel { left: 34%; right: -2%; top: 9%; bottom: 9%; border-radius: 40px; }
    html.story-on .story-captions { inset-inline: auto; left: 0; top: 50%; bottom: auto; width: 31%; height: 280px; transform: translateY(-50%); text-align: start; }
    html.story-on .story-cap { display: block; top: 0; bottom: auto; }
    html.story-on .story-dots { left: 0; top: auto; bottom: 0; transform: none; }
    html.story-on .story-hub { left: 62%; }
  }

  /* ---------- Native scroll-driven animations (html.story-sda): the whole story runs on the compositor ---------- */
  /* Root scroll timeline: ranges are absolute scroll offsets, --story-top (section top, measured once) plus a share of the
     sticky travel (section height minus one screen). WebKit does not drive view-timeline `contain` ranges on a tall subject. */
  html.story-sda .hero-story { --story-top: 72px; --story-len: calc(var(--story-vh, 100svh) * 4.6); }
  html.story-sda .story-intro { animation: sy-intro linear both; animation-timeline: scroll(root); animation-range: calc(var(--story-top) + var(--story-len) * 0) calc(var(--story-top) + var(--story-len) * 0.12); }
