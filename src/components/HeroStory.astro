<script>
  // Scroll-driven story. Progress is read on scroll (one write per animation frame) and every animated
  // element gets its final transform/opacity written directly, so no custom property changes on a big
  // ancestor and the phone subtrees never restyle. Small scan details still use --t / --in / --out.
  const sec = document.querySelector<HTMLElement>('[data-story]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sec && !reduce && document.documentElement.classList.contains('story-sda')) {
    // Native path: give the timeline the section's document offset (stable; re-measured on resize).
    let lastTop = '';
    const top = () => {
      const r = sec.getBoundingClientRect();
      const v = `${Math.round(r.top + (window.scrollY || document.documentElement.scrollTop))}px`;
      if (v !== lastTop) { lastTop = v; sec.style.setProperty('--story-top', v); }
    };
    top(); window.addEventListener('resize', top); window.addEventListener('load', top);
  }
  if (sec && !reduce && !document.documentElement.classList.contains('story-sda')) {
    type Win = [number, number];
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
    const parse = (s?: string) => (s ? (s.split(',').map(Number) as Win) : null);
    const seg = (p: number, w: Win) => ease((p - w[0]) / (w[1] - w[0]));
    const q = (sel: string) => sec.querySelector<HTMLElement>(sel)!;
    const qa = (sel: string) => Array.from(sec.querySelectorAll<HTMLElement>(sel));
    const BIG = '.story-intro,.story-panel,.story-hub,.story-screen,.story-card,.story-cap';
    const intro = q('.story-intro'), panel = q('.story-panel'), hub = q('.story-hub');
    const sideL = q('.story-side-l'), sideR = q('.story-side-r'), dots = q('.story-dots');
    const faders = (sel: string) => qa(sel).map((el) => ({ el, i: parse(el.dataset.in)!, o: parse(el.dataset.out), last: '' }));
    const screens = faders('.story-screen'), cards = faders('.story-card'), caps = faders('.story-cap');
    const small = qa('[data-win],[data-in]').filter((el) => !el.matches(BIG)).map((el) => ({ el, win: parse(el.dataset.win), i: parse(el.dataset.in), o: parse(el.dataset.out), last: '' }));
    const desktopMq = window.matchMedia('(min-width: 64rem)');
    const stage = q('.story-stage');
    const SIDE = 243;
    let ps = 1, arrive = 0, shift = 0, last = -1, stageH = 0, lastW = 0;

    // Phone scale and arrival distances from the viewport (natural phone: 360 × ~740 px; fan: 744 wide).
    const size = () => {
      // The stage is sized in px by the bootstrap script, so nothing here moves when iOS collapses its address bar.
      stageH = stage.getBoundingClientRect().height;
      const vh = stageH, vw = window.innerWidth, desktop = desktopMq.matches;
      const fit = desktop ? (vh - 200) / 740 : Math.min((vw - 32) / 744, (vh * 0.5) / 740);
      ps = Math.max(0.42, Math.min(1, fit));
      arrive = desktop ? vh * 0.6 : vh * 0.58;
      shift = desktop ? -vw * 0.1 : 0;
      last = -1;
    };
    const f3 = (v: number) => v.toFixed(3);
    // Write opacity + transform only when they change; hide fully transparent layers so they cost nothing.
    const fade = (it: { el: HTMLElement; i: Win; o: Win | null; last: string }, p: number, move: (i: number, o: number) => string) => {
      const i = seg(p, it.i), o = it.o ? seg(p, it.o) : 0;
      const key = f3(i) + '/' + f3(o);
      if (key === it.last) return;
      it.last = key;
      const v = i * (1 - o);
      it.el.style.opacity = f3(v);
      it.el.style.transform = move(i, o);
    };

    const frame = () => {
      const r = sec.getBoundingClientRect();
      const total = r.height - stageH;
      const p = total > 0 ? clamp(-r.top / total) : 0;
      if (p === last) return;
      last = p; sec.dataset.p = p.toFixed(3);
      // Beat marker
      const beat = String(p < 0.14 ? 0 : p < 0.43 ? 1 : p < 0.62 ? 2 : p < 0.82 ? 3 : 4);
      if (dots.dataset.beat !== beat) dots.dataset.beat = beat;
      dots.style.opacity = f3(ease((p - 0.14) / 0.06));
      // Headline out
      const ti = seg(p, [0, 0.12]);
      intro.style.opacity = f3(1 - ti);
      intro.style.transform = `translateY(${f3(-56 * ti)}px)`;
      intro.style.visibility = ti >= 1 ? 'hidden' : '';
      // Fan arrives: hub rises and grows, panel fades in, side phones fan out
      const th = seg(p, [0.02, 0.18]);
      hub.style.transform = `translate(-50%, -50%) translate(${f3((1 - th) * shift)}px, ${f3((1 - th) * arrive)}px) scale(${f3(ps)})`;
      panel.style.opacity = f3(th);
      panel.style.transform = `translateY(${f3((1 - th) * 40)}px)`;
      const sy = f3(56 + (1 - th) * 60), ss = '0.86', so = f3(th);
      sideL.style.transform = `translate3d(${f3(-th * SIDE)}px, ${sy}px, 0) rotateY(${f3(th * 12)}deg) scale(${ss})`;
      sideR.style.transform = `translate3d(${f3(th * SIDE)}px, ${sy}px, 0) rotateY(${f3(-th * 12)}deg) scale(${ss})`;
      sideL.style.opacity = so; sideR.style.opacity = so;
      // Screens, cards, captions
      for (const it of screens) fade(it, p, (i, o) => `translateY(${f3((1 - i) * 28 - o * 10)}px)`);
      for (const it of cards) fade(it, p, (i, o) => `scale(${f3(1 / ps)}) translateY(${f3((1 - i) * 36 - o * 20)}px)`);
      for (const it of caps) fade(it, p, (i, o) => `translateY(${f3((1 - i) * 32 - o * 24)}px)`);
      // Small scan details keep their custom properties (tiny subtrees)
      for (const it of small) {
        let off = false, key = '';
        let t = 0, i = 0, o = 0;
        if (it.win) { t = seg(p, it.win); key += f3(t); off = it.el.dataset.offAt === 'end' && t === 1; }
        if (it.i) { i = seg(p, it.i); o = it.o ? seg(p, it.o) : 0; key += '/' + f3(i) + '/' + f3(o); off = i === 0 || o === 1; }
        if (key === it.last) continue;
        it.last = key;
        if (it.win) it.el.style.setProperty('--t', f3(t));
        if (it.i) { it.el.style.setProperty('--in', f3(i)); it.el.style.setProperty('--out', f3(o)); }
        if (off) it.el.setAttribute('data-off', ''); else it.el.removeAttribute('data-off');
      }
    };

    // One update per frame, only when the page actually scrolled (or resized / the section came into view).
    let queued = false;
    const schedule = () => { if (queued) return; queued = true; requestAnimationFrame(() => { queued = false; frame(); }); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => { if (window.innerWidth === lastW) return; lastW = window.innerWidth; size(); schedule(); });
    if ('IntersectionObserver' in window) new IntersectionObserver(schedule, { threshold: [0, 0.01, 0.5, 0.99, 1] }).observe(sec);
    lastW = window.innerWidth; size(); frame();
  }
  // On-device readout for diagnosing the story: open the page with #debug.
  if (sec && location.hash === '#debug') {
    const box = document.createElement('pre');
    box.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99;margin:0;padding:6px 8px;border-radius:8px;background:rgba(0,0,0,.75);color:#fff;font:11px/1.4 ui-monospace,Menlo,monospace;pointer-events:none';
    document.body.appendChild(box);
    const html = document.documentElement;
    const upd = () => {
      const r = sec.getBoundingClientRect();
      const stageH = sec.firstElementChild ? sec.firstElementChild.getBoundingClientRect().height : 0;
      const p = r.height - stageH > 0 ? Math.min(1, Math.max(0, -r.top / (r.height - stageH))) : 0;
      box.textContent = `path ${html.classList.contains('story-sda') ? 'native' : reduce ? 'reduced' : 'js'}  p ${p.toFixed(3)}\nvh ${html.style.getPropertyValue('--story-vh')} inner ${window.innerHeight} ps ${html.style.getPropertyValue('--story-ps')}\ntop ${sec.style.getPropertyValue('--story-top') || '-'} sec ${Math.round(r.height)}\n${navigator.userAgent.slice(0, 80)}`;
    };
    upd(); window.addEventListener('scroll', upd, { passive: true }); window.addEventListener('resize', upd);
  }
</script>
