---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import type { Status } from '../data/site';
// No partner names until Leon confirms in writing.
const rows: { label: string; status: Status }[] = [
  { label: 'Online card payments, Apple Pay and digital tipping', status: 'live' },
  { label: 'Hotel PMS', status: 'dev' },
  { label: 'Parking and barrier systems', status: 'dev' },
  { label: 'Salik and Dubai payments', status: 'exploring' },
  { label: 'Crypto payments', status: 'exploring' },
  { label: 'Car care while parked (cleaning, fuel)', status: 'exploring' },
];
---
<section id="integrations" class="section-pad scroll-mt-20" aria-labelledby="integrations-title">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHead id="integrations-title" eyebrow="Integrations and partners" title="Built to plug into the venue." />
      </div>
      <ul class="lg:col-span-8">
        {rows.map((r) => (
          <li class="hairline-t flex items-center justify-between gap-6 py-5">
            <span class="t-body">{r.label}</span>
            <Pill status={r.status} />
          </li>
        ))}
        <li class="hairline-t"></li>
      </ul>
    </div>
  </div>
</section>
