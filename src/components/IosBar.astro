---
/** iPhone status bar with the Dynamic Island, drawn over the top of a phone screen (decorative). */
/** island: false when the screen draws its own Dynamic Island (the guest page animates it for Face ID). */
interface Props { time?: string; tone?: 'light' | 'dark'; island?: boolean }
const { time = '1:06', tone = 'light', island = true } = Astro.props;
---
<div class:list={['ios-bar', tone === 'dark' && 'ios-bar-dark']} aria-hidden="true">
  <span class="ios-time">{time}</span>
  {island && <span class="ios-island"></span>}
  <span class="ios-icons">
    <svg viewBox="0 0 18 12" width="16" height="11" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="0.8"/><rect x="5" y="5.5" width="3" height="6.5" rx="0.8"/><rect x="10" y="3" width="3" height="9" rx="0.8"/><rect x="15" y="0" width="3" height="12" rx="0.8"/></svg>
    <svg viewBox="0 0 16 12" width="14" height="11" fill="currentColor"><path d="M8 2.2c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .4C5.2.4 2.7 1.5.8 3.3L2 4.6a8.6 8.6 0 0 1 6-2.4zm0 3.6c1.3 0 2.6.5 3.5 1.4l1.2-1.3A6.9 6.9 0 0 0 8 4c-1.8 0-3.5.7-4.7 1.9l1.2 1.3c.9-.9 2.2-1.4 3.5-1.4zm0 3.5c-.6 0-1.1.2-1.5.6L8 11.6l1.5-1.7c-.4-.4-.9-.6-1.5-.6z"/></svg>
    <svg viewBox="0 0 27 12" width="24" height="11" fill="none"><rect x="0.5" y="0.5" width="22" height="11" rx="3.2" stroke="currentColor" opacity=".4"/><rect x="2" y="2" width="15" height="8" rx="1.8" fill="currentColor"/><path d="M24.2 4v4c.8-.3 1.3-1.1 1.3-2s-.5-1.7-1.3-2z" fill="currentColor" opacity=".45"/></svg>
  </span>
</div>

<style>
  .ios-bar { position: absolute; inset-inline: 0; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; height: 44px; padding-inline: 26px 22px; color: #fff;
    font: 600 13px/1 -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; letter-spacing: -0.01em; pointer-events: none; }
  .ios-bar-dark { color: #000; }
  .ios-time { min-width: 44px; padding-top: 1px; }
  .ios-island { position: absolute; top: 10px; left: 50%; width: 31%; height: 26px; transform: translateX(-50%); border-radius: 13px; background: #000; }
  .ios-icons { display: inline-flex; align-items: center; gap: 5px; }
</style>
