---
/**
 * A short silent product loop in a glass frame. 16:9 from md up; on phones square (`mobile="1x1"`, default)
 * or 4:3 (`mobile="4x3"`) for wide scenes. Expects /film/<name>-{16x9,<mobile>}.mp4 and
 * /film/<name>-start-{16x9,<mobile>}.webp. Each loop file begins on its finished frame (both screens lit),
 * so the poster never looks empty and playback picks up from exactly what is already showing.
 *
 * Loading: nothing on page load. On the visitor's first scroll the right file for the screen size is fetched
 * into memory (iOS Safari otherwise waits for most of the file over the network before it starts). It is handed
 * to the video (preload auto, so the first frames are decoded) when the loop is within about a screen and a half,
 * and it starts playing half a screen before it scrolls into view, so it is already moving when it appears.
 * The frame is a plain white card, not backdrop-blurred glass: a blur around a playing video costs iOS frames.
 * Loops are encoded at their native 24 fps (a 30 fps conversion repeated every 4th frame and juddered).
 * Reduced motion: no download, the poster stays.
 * iPhone Low Power Mode (and some data-saver settings) refuse every video that starts by itself. When play() is
 * refused, the same loop is shown as an animated AVIF image instead (/film/<name>-<ratio>.avif, ~200-370 KB),
 * which plays on its own: no button, no tap. Only those visitors download it.
 */
interface Props {
  name: string;
  label: string;
  mobile?: '1x1' | '4x3';
  /** The studio tone at the clip's edges, so the frame matches before the poster paints. */
  bg?: string;
  class?: string;
}
const { name, label, mobile = '1x1', bg = '#ecede8', class: cls = '' } = Astro.props;
const f = `/film/${name}`;
---
<figure class:list={['loop-frame rounded-frame p-2 md:p-3', cls]} data-reveal>
  <div class:list={['relative overflow-hidden rounded-[14px] md:aspect-video', mobile === '4x3' ? 'aspect-[4/3]' : 'aspect-square']} style={`background:${bg}`}>
    <video
      class="absolute inset-0 h-full w-full object-cover"
      muted
      loop
      playsinline
      preload="none"
      disableRemotePlayback
      aria-label={label}
      data-loop
      data-src-wide={`${f}-16x9.mp4`}
      data-src-tall={`${f}-${mobile}.mp4`}
      data-poster-wide={`${f}-start-16x9.webp`}
      data-poster-tall={`${f}-start-${mobile}.webp`}
      data-anim-wide={`${f}-16x9.avif`}
      data-anim-tall={`${f}-${mobile}.avif`}
    ></video>
  </div>
</figure>

<script>
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-loop]'));
  const tall = window.matchMedia('(max-width: 767px)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const playing = new Set<HTMLVideoElement>(); // within half a screen of the viewport
  const near = new Set<HTMLVideoElement>(); // within a screen and a half
  const src = new Map<HTMLVideoElement, string>(); // fetched blob URLs, waiting to be attached
  const jobs = new Map<HTMLVideoElement, Promise<void>>();

  const box = (v: HTMLVideoElement) => v.closest('figure')!;
  // Autoplay refused (Low Power Mode): swap in the animated image of the same loop.
  const asImage = (v: HTMLVideoElement) => {
    if (v.dataset.asImage) return;
    v.dataset.asImage = '1';
    const img = document.createElement('img');
    img.alt = v.getAttribute('aria-label') || '';
    img.decoding = 'async';
    img.className = 'loop-anim absolute inset-0 h-full w-full object-cover';
    img.onload = () => { v.style.visibility = 'hidden'; v.pause(); };
    img.src = (tall ? v.dataset.animTall : v.dataset.animWide) || '';
    v.after(img);
  };
  const tryPlay = (v: HTMLVideoElement) => { if (!v.dataset.asImage) v.play().catch((e) => { if (e?.name === 'NotAllowedError') asImage(v); }); };
  const attach = (v: HTMLVideoElement) => {
    const u = src.get(v);
    if (!u || !near.has(v) || v.getAttribute('src')) return;
    v.preload = 'auto'; // decode ahead, so play() starts at once
    v.src = u;
    if (playing.has(v)) tryPlay(v);
  };
  const fetchOne = (v: HTMLVideoElement): Promise<void> => {
    if (!jobs.has(v)) {
      const url = (tall ? v.dataset.srcTall : v.dataset.srcWide) || '';
      jobs.set(v, fetch(url)
        .then((r) => (r.ok ? r.blob() : Promise.reject(r.status)))
        .then((b) => { src.set(v, URL.createObjectURL(b)); })
        .catch(() => { src.set(v, url); }) // network hiccup: let the element stream it
        .then(() => attach(v)));
    }
    return jobs.get(v)!;
  };
  // One at a time, in page order, so the first loop is ready as early as possible.
  const fetchAll = () => { videos.reduce((chain, v) => chain.then(() => fetchOne(v)), Promise.resolve()); };

  for (const v of videos) v.poster = (tall ? v.dataset.posterTall : v.dataset.posterWide) || '';
  if (!reduce && videos.length) {
    // First scroll or touch anywhere: download every loop (under 1 MB on a phone) while the visitor reads the hero.
    addEventListener('scroll', fetchAll, { once: true, passive: true });
    addEventListener('touchstart', fetchAll, { once: true, passive: true });
    if ('IntersectionObserver' in window) {
      const nearIO = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { near.add(v); fetchOne(v); attach(v); } else near.delete(v);
      }), { rootMargin: '150% 0px 150% 0px' });
      const playIO = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { playing.add(v); near.add(v); fetchOne(v); attach(v); if (v.getAttribute('src')) tryPlay(v); }
        else { playing.delete(v); v.pause(); }
      }), { rootMargin: '50% 0px 50% 0px' });
      videos.forEach((v) => { nearIO.observe(v); playIO.observe(v); });
    } else { videos.forEach((v) => { near.add(v); playing.add(v); }); fetchAll(); }
  }
</script>

<style>
  .loop-frame { background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), inset 0 0 0 1px rgba(0, 0, 0, 0.06); }
</style>
