---
import Wordmark from './Wordmark.astro';
import { nav } from '../data/site';
interface Props { demoHref?: string }
const { demoHref = '#demo' } = Astro.props;
---
<header class="sticky top-0 z-50 pt-3 px-3 md:pt-4 md:px-4 pointer-events-none">
  <nav
    aria-label="Primary"
    class="glass pointer-events-auto mx-auto flex max-w-[1200px] items-center justify-between rounded-pill ps-5 pe-2 py-2"
    data-nav
  >
    <Wordmark as="a" href="/" class="text-[18px] md:text-[20px] text-ink" />
    <ul class="hidden lg:flex items-center gap-7 text-[15px] font-medium text-ink-2">
      {nav.map((n) => (
        <li><a class="hover:text-ink transition-colors" href={n.href}>{n.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-1.5">
      <a href={demoHref} class="btn-primary !py-2.5 !px-5 text-[14px]">Book a demo</a>
      <button type="button" class="inline-flex size-10 items-center justify-center rounded-full text-ink lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path class="menu-icon menu-open" d="M4 7h16M4 12h16M4 17h16"/><path class="menu-icon menu-close" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="menu-panel pointer-events-auto mx-auto mt-2 max-w-[1200px] rounded-[24px] border border-line p-3 lg:hidden" hidden>
    <ul class="flex flex-col">
      {nav.map((n, i) => (
        <li style={`--i:${i}`}><a class="block rounded-[14px] px-4 py-3 text-[17px] font-medium text-ink hover:bg-field" href={n.href} data-menu-link>{n.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Mobile menu: the panel unrolls down from the bar (clip-path), links follow one after another, the icon turns
     into a cross. Solid panel, no backdrop blur: blurring a moving layer is what stutters on iPhone. */
  .menu-panel {
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 24px 48px -24px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(-12px);
    clip-path: inset(0 0 100% 0 round 24px);
    transition: opacity 240ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1), clip-path 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, clip-path;
  }
  .menu-panel li { opacity: 0; transform: translateY(-8px); transition: opacity 240ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1); }
  .menu-panel[data-open] { opacity: 1; transform: none; clip-path: inset(0 0 0 0 round 24px); }
  .menu-panel[data-open] li { opacity: 1; transform: none; transition-delay: calc(90ms + var(--i) * 45ms); }
  .menu-icon { transform-box: fill-box; transform-origin: center; transition: opacity 200ms ease, transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .menu-close { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  [aria-expanded='true'] .menu-open { opacity: 0; transform: rotate(90deg) scale(0.6); }
  [aria-expanded='true'] .menu-close { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .menu-panel li, .menu-icon { transition: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    let timer = 0;
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const set = (open: boolean) => {
      if (open === isOpen()) return;
      clearTimeout(timer);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        menu.hidden = false;
        // Two frames: the first paints the closed state, the second starts the transition (one reflow is not
        // always enough for iOS Safari to animate an element that was display:none).
        requestAnimationFrame(() => requestAnimationFrame(() => { if (toggle.getAttribute('aria-expanded') === 'true') menu.setAttribute('data-open', ''); }));
      } else {
        menu.removeAttribute('data-open');
        timer = window.setTimeout(() => { if (!isOpen()) menu.hidden = true; }, 440);
      }
    };
    toggle.addEventListener('click', () => set(!isOpen()));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    // Tap anywhere outside the bar and the menu to close it.
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) set(false);
    });
  }
</script>