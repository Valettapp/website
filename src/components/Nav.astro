---
import Wordmark from './Wordmark.astro';
import { nav } from '../data/site';
---
<header class="sticky top-0 z-50 pt-3 px-3 md:pt-4 md:px-4 pointer-events-none">
  <nav
    aria-label="Primary"
    class="glass pointer-events-auto mx-auto flex max-w-[1200px] items-center justify-between rounded-pill ps-5 pe-2 py-2"
    data-nav
  >
    <Wordmark as="a" href="#top" class="text-[18px] md:text-[20px] text-ink" />
    <ul class="hidden lg:flex items-center gap-7 text-[15px] font-medium text-ink-2">
      {nav.map((n) => (
        <li><a class="hover:text-ink transition-colors" href={n.href}>{n.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-1.5">
      <a href="#demo" class="btn-primary !py-2.5 !px-5 text-[14px]">Book a demo</a>
      <button type="button" class="inline-flex size-10 items-center justify-center rounded-full text-ink lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path class="menu-open" d="M4 7h16M4 12h16M4 17h16"/><path class="menu-close hidden" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="glass pointer-events-auto mx-auto mt-2 hidden max-w-[1200px] rounded-[24px] p-3 lg:hidden" hidden>
    <ul class="flex flex-col">
      {nav.map((n) => (
        <li><a class="block rounded-[14px] px-4 py-3 text-[17px] font-medium text-ink hover:bg-field" href={n.href} data-menu-link>{n.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open; menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => set(menu.hidden));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
