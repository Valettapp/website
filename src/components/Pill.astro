---
import { statusLabel, type Status } from '../data/site';
interface Props {
  status: Status;
  class?: string;
}
const { status, class: className = '' } = Astro.props;
const cls = status === 'live' ? 'pill-live' : status === 'dev' ? 'pill-dev' : 'pill-exploring';
---
<span class:list={['pill', cls, className]}>
  {status === 'live' && <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-gold"></span>}
  {statusLabel[status]}
</span>
