---
import { statusLabel, type Status } from '../data/site';
interface Props {
  status: Status;
  class?: string;
}
const { status, class: className = '' } = Astro.props;
const cls = status === 'live' ? 'pill-live' : status === 'dev' ? 'pill-dev' : 'pill-exploring';
---
{status !== 'live' && <span class:list={['pill', cls, className]}>{statusLabel[status]}</span>}
