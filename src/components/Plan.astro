---
import SectionHead from './SectionHead.astro';
// Portraits: initials on #F2F2F0 circles until photos arrive.
const founders = [
  { name: 'Leon Lumley-Savile', role: 'Co-founder', bio: 'Real estate and commodity trading, with a network of ultra-high-net-worth clients who trust him to deliver vetted products and deals worldwide.' },
  { name: 'Tom Beenham', role: 'Co-founder', bio: 'Marketing. Built an email-marketing business that generated millions in revenue for top clients, and an online school that has taken students to the top of the industry.' },
];
const investors = [
  { name: 'Abdulla Al Shaibani', role: 'Investor and advisor', bio: 'Managing partner of Alphabeta Properties, which he founded in 2016 while at the American University of Sharjah; named among Forbes Middle East’s Most Impactful Real Estate Leaders 2025. Developments include C6, M77 and the Q-East mixed-use complex in Al Quoz. Also founder of Axeed and Fanak Auto.' },
  { name: 'Mo Aziz', role: 'Investor and advisor', bio: 'Third-generation serial technology entrepreneur with deep operational expertise. Fintech specialist, and the first UAE-based founder to go through Y Combinator, in 2019.' },
];
const initials = (n: string) => n.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
---
<section data-reveal-group id="company" class="section-pad scroll-mt-20" aria-labelledby="company-title">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead id="company-title" eyebrow="The company" title="An old service, rebuilt for the AI era." />
      </div>
      <div class="flex flex-col gap-6 lg:col-span-7 lg:pt-3">
        <p class="t-body measure">
          Valett started as an idea in summer 2025. By winter it was a vetted start-up, and by December 2025 it had raised significant capital. It launches before December 2026 with major luxury hospitality brands in Dubai already signed, and more hotels, residential buildings and developers signing.
        </p>
        <div class="measure">
          <p class="t-eyebrow">Five-year plan</p>
          <p class="t-body mt-2 text-ink-2">Grow. Capture the Dubai market. Expand across the service side of hospitality: concierge, parking automation and AI.</p>
        </div>
      </div>
    </div>

    <div class="mt-20 grid gap-14 md:mt-28 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="t-eyebrow">Founders</p>
        <ul class="mt-6 flex flex-col gap-8">
          {founders.map((p) => (
            <li class="flex gap-5">
              <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-field text-[18px] font-medium tracking-[0.04em] text-ink-2" aria-hidden="true">{initials(p.name)}</span>
              <div>
                <h3 class="t-h3 !text-[20px]">{p.name}</h3>
                <p class="t-caption mt-0.5">{p.role}</p>
                <p class="mt-3 text-[16px] leading-relaxed text-ink-2">{p.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="t-eyebrow">Investors and advisors</p>
        <ul class="mt-6 flex flex-col gap-8">
          {investors.map((p) => (
            <li class="flex gap-5">
              <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-field text-[18px] font-medium tracking-[0.04em] text-ink-2" aria-hidden="true">{initials(p.name)}</span>
              <div>
                <h3 class="t-h3 !text-[20px]">{p.name}</h3>
                <p class="t-caption mt-0.5">{p.role}</p>
                <p class="mt-3 text-[16px] leading-relaxed text-ink-2">{p.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
