---
import SectionHead from './SectionHead.astro';
import Ambient from './Ambient.astro';
import { Picture } from 'astro:assets';
import leon from '../assets/team/leon.jpg';
import tom from '../assets/team/tom.jpg';
import abdulla from '../assets/team/abdulla.jpg';
import mo from '../assets/team/mo.jpg';
import type { ImageMetadata } from 'astro';
// Portraits supplied by Leon: founders and Abdulla 27 Oct, Mo 30 Oct (200 px original, cropped and sharpened; no AI retouching).
const founders = [
  { name: 'Leon Lumley-Savile', photo: leon, role: 'Co-founder and CEO', focus: 'Partnerships, venues and capital', bio: 'Leon leads Valett and its business development, bringing the first major hotels and luxury venues in Dubai onto the platform. Before Valett he built his career in real estate and commodity trading, structuring and closing multi-million-dollar deals for a wide network of ultra-high-net-worth clients who trust him to deliver vetted products and opportunities across the world. He brings that network, and that standard of diligence, to every venue Valett signs.' },
  { name: 'Tom Beenham', photo: tom, role: 'Co-founder, CTO and head of technology', focus: 'Technology and AI', bio: 'Tom leads Valett’s technology and AI, and the engineering team that builds it. Under his direction the company has developed its own vehicle recognition, the AI models that read a car from a single photo, and the platform that runs every venue on the network, with demand prediction and automatic driver assignment next. Before Valett he built an email-marketing business that generated millions in revenue for top clients, and an online school that has taken students to the top of the industry.' },
];
const investors = [
  { name: 'Abdulla Al Shaibani', photo: abdulla as ImageMetadata | undefined, role: 'Investor and advisor', focus: 'Real estate and development', bio: 'Managing partner of Alphabeta Properties, which he founded in 2016 while at the American University of Sharjah; named among Forbes Middle East’s Most Impactful Real Estate Leaders 2025. Developments include C6, M77 and the Q-East mixed-use complex in Al Quoz. Also founder of Axeed and Fanak Auto.' },
  { name: 'Mo Aziz', photo: mo as ImageMetadata | undefined, role: 'Investor and advisor', focus: 'Fintech and proptech', bio: 'Dubai-based serial tech entrepreneur and the first UAE-based founder through Y Combinator, in 2019. Co-founder and co-CEO of Sooner, the proptech platform taking first-time buyers from renting to owning. Co-founded Pluto, the Y Combinator-backed spend management platform, through to its exit, and Dapi and Airscope before it. Angel investor in the region’s fintech and proptech founders.' },
];
const divisions = [
  { title: 'Founders', body: 'Leon leads the company, partnerships and capital. Tom leads technology. The two people who waited thirty minutes for a car and decided to fix it.' },
  { title: 'Investors and advisors', body: 'Real estate, development, fintech and proptech. The people who opened the doors in Dubai.' },
  { title: 'Technology and AI', body: 'Led by Tom. The engineering team behind Valett’s vehicle recognition, its AI models and the platform that runs every venue. Profiles to follow.' },
];
const initials = (n: string) => n.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
---
<section data-reveal-group id="company" class="section-pad scroll-mt-20" aria-labelledby="company-title">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead id="company-title" eyebrow="The company" title="An old service, rebuilt for the AI era." />
      </div>
      <div class="flex flex-col gap-6 lg:col-span-7 lg:pt-3">
        <p class="t-body measure">
          Valett started as an idea in summer 2025. By winter it was a vetted start-up, and by December 2025 it had raised significant capital. It launches before December 2026 with major luxury hospitality brands in Dubai already signed, and more hotels, residential buildings and developers signing.
        </p>
        <div class="measure">
          <p class="t-eyebrow">Five-year plan</p>
          <p class="t-body mt-2 text-ink-2">Grow. Capture the Dubai market. Expand across the service side of hospitality: concierge, parking automation and AI.</p>
        </div>
      </div>
    </div>

    {/* Divisions */}
    <ul class="mt-20 grid gap-6 md:mt-28 md:grid-cols-3" data-reveal-stagger>
      {divisions.map((d, i) => (
        <li class="hairline-t flex flex-col gap-2 pt-6">
          <p class="t-eyebrow">0{i + 1}</p>
          <h3 class="t-h3">{d.title}</h3>
          <p class="text-[16px] leading-relaxed text-ink-2">{d.body}</p>
        </li>
      ))}
    </ul>

    {/* Profiles */}
    <div class="relative mt-20 md:mt-28" data-reveal><Ambient variant="wide" class="-inset-y-[10%]" />
      <p class="t-eyebrow">Founders</p>
      <ul class="mt-6 grid gap-6 md:grid-cols-2" data-reveal-stagger="scale">
        {founders.map((p) => (
          <li class="glass-card flex flex-col gap-5 p-6 md:p-8">
            <div class="flex items-center gap-4">
              <Picture src={p.photo} formats={['avif', 'webp']} widths={[128, 256]} sizes="64px" alt={`Portrait of ${p.name}`} class="size-16 shrink-0 rounded-full object-cover md:size-20" pictureAttributes={{ class: "shrink-0" }} loading="lazy" decoding="async" />
              <div><h3 class="t-h3 !text-[20px]">{p.name}</h3><p class="t-caption mt-0.5">{p.role} · {p.focus}</p></div>
            </div>
            <div><p class="bio text-[16px] leading-relaxed text-ink-2" id={`bio-${p.name.split(' ')[0].toLowerCase()}`}>{p.bio}</p>
              <button type="button" class="bio-toggle" aria-expanded="false" aria-controls={`bio-${p.name.split(' ')[0].toLowerCase()}`} hidden><span class="bio-more">Read more</span><span class="bio-less">Show less</span></button></div>
          </li>
        ))}
      </ul>
    </div>
    <div class="relative mt-14 md:mt-20" data-reveal><Ambient variant="right" class="-inset-y-[10%]" />
      <p class="t-eyebrow">Investors and advisors</p>
      <ul class="mt-6 grid gap-6 md:grid-cols-2" data-reveal-stagger="scale">
        {investors.map((p) => (
          <li class="glass-card flex flex-col gap-5 p-6 md:p-8">
            <div class="flex items-center gap-4">
              {p.photo ? (
                <Picture src={p.photo} formats={['avif', 'webp']} widths={[128, 256]} sizes="64px" alt={`Portrait of ${p.name}`} class="size-16 shrink-0 rounded-full object-cover md:size-20" pictureAttributes={{ class: "shrink-0" }} loading="lazy" decoding="async" />
              ) : (
                <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-field text-[18px] font-semibold tracking-[0.04em] text-ink-2 md:size-20" aria-hidden="true">{initials(p.name)}</span>
              )}
              <div><h3 class="t-h3 !text-[20px]">{p.name}</h3><p class="t-caption mt-0.5">{p.role} · {p.focus}</p></div>
            </div>
            <div><p class="bio text-[16px] leading-relaxed text-ink-2" id={`bio-${p.name.split(' ')[0].toLowerCase()}`}>{p.bio}</p>
              <button type="button" class="bio-toggle" aria-expanded="false" aria-controls={`bio-${p.name.split(' ')[0].toLowerCase()}`} hidden><span class="bio-more">Read more</span><span class="bio-less">Show less</span></button></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Phones and tablets: three lines of each bio, "Read more" for the rest (only once the script has run).
     The script animates the height between the two, so the card glides open and closed. */
  .bio-toggle { margin-top: 10px; font-size: 14px; font-weight: 500; color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .bio-less, [data-open] > .bio-toggle .bio-more { display: none; }
  [data-open] > .bio-toggle .bio-less { display: inline; }
  .bio-toggle span { animation: bio-label 260ms ease both; }
  @media (max-width: 63.99rem) {
    [data-clamp] > .bio { overflow: hidden; }
    [data-clamp]:not([data-open]):not([data-moving]) > .bio { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; }
    [data-clamp] > .bio.bio-anim { transition: height 480ms cubic-bezier(0.22, 1, 0.36, 1); }
  }
  @media (min-width: 64rem) { .bio-toggle { display: none !important; } }
  @keyframes bio-label { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { [data-clamp] > .bio.bio-anim { transition: none; } .bio-toggle span { animation: none; } }
</style>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLButtonElement>('.bio-toggle').forEach((b) => {
    const box = b.parentElement!;
    const bio = box.querySelector<HTMLElement>('.bio')!;
    box.setAttribute('data-clamp', '');
    b.hidden = false;
    let done: (() => void) | null = null;
    b.addEventListener('click', () => {
      done?.();
      const opening = !box.hasAttribute('data-open');
      b.setAttribute('aria-expanded', String(opening));
      if (reduce || window.matchMedia('(min-width: 64rem)').matches) { box.toggleAttribute('data-open', opening); return; }
      const from = bio.offsetHeight;
      box.setAttribute('data-moving', ''); // full text while it moves
      box.toggleAttribute('data-open', opening);
      const lines = parseFloat(getComputedStyle(bio).lineHeight) * 3;
      const to = opening ? bio.scrollHeight : Math.round(lines);
      bio.style.height = `${from}px`;
      bio.offsetHeight; // commit the start height
      bio.classList.add('bio-anim');
      bio.style.height = `${to}px`;
      const end = () => { bio.removeEventListener('transitionend', end); bio.classList.remove('bio-anim'); bio.style.height = ''; box.removeAttribute('data-moving'); done = null; };
      done = end;
      bio.addEventListener('transitionend', end);
      window.setTimeout(() => done === end && end(), 700);
    });
  });
</script>
