---
/**
 * UAE number plates as exact replicas: photographic crops of real plates.
 *  - Dubai:     the plate on the Defender (M 95378) from the car photo.
 *  - Sharjah, Abu Dhabi, Fujairah: the reference plates supplied 27 Oct.
 * Size with `scale` (1 = 220 px wide). The `code`/`number` props feed the accessible label only.
 */
import { Picture } from 'astro:assets';
import dubai from '../assets/plates/dubai.png';
import sharjah from '../assets/plates/sharjah.png';
import abudhabi from '../assets/plates/abudhabi.png';
import fujairah from '../assets/plates/fujairah.png';
interface Props { emirate: 'Dubai' | 'Abu Dhabi' | 'Sharjah' | 'Fujairah'; code: string; number: string; class?: string; scale?: number }
const { emirate, code, number, class: className = '', scale = 1 } = Astro.props;
const img = { Dubai: dubai, 'Abu Dhabi': abudhabi, Sharjah: sharjah, Fujairah: fujairah }[emirate];
const width = Math.round(220 * scale);
---
<span class:list={['plate-uae inline-block overflow-hidden rounded-[4px] shadow-[0_1px_2px_rgba(0,0,0,.2)]', className]} style={`width:${width}px`} role="img" aria-label={`${emirate} plate ${code} ${number}`}>
  <Picture src={img} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={`${width}px`} alt="" class="block w-full" loading="lazy" decoding="async" />
</span>
