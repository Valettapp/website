---
/**
 * UAE number plates drawn to match the reference set exactly (layout, colours, typography).
 * All plates: white face, black 2 px frame, bold condensed black digits.
 *  - Dubai:     "DUBAI" in the blue/magenta stylised lettering over the code letter, number right.
 *  - Abu Dhabi: red block with the white code number on the left, Arabic/English "U.A.E A.D" stack, number right.
 *  - Sharjah:   light grey face; code left; Arabic "الشارقة" over "U.A.E" + "SHARJAH" centre; number right.
 *  - Fujairah:  light grey face; code letter left; Arabic calligraphy mark over "FUJAIRAH / U.A.E" centre; number right.
 * Drawn in HTML/SVG, no raster logos. Size with the `scale` prop (1 = 220 px wide).
 */
interface Props { emirate: 'Dubai' | 'Abu Dhabi' | 'Sharjah' | 'Fujairah'; code: string; number: string; class?: string; scale?: number }
const { emirate, code, number, class: className = '', scale = 1 } = Astro.props;
---
<div class:list={['plate-uae', className]} data-emirate={emirate} style={`--s:${scale}`} role="img" aria-label={`${emirate} plate ${code} ${number}`}>
  {emirate === 'Dubai' && (
    <>
      <span class="p-left">
        <span class="p-dubai" aria-hidden="true"><i>D</i><i>U</i><i>B</i><i>A</i><i>I</i></span>
        <span class="p-code">{code}</span>
      </span>
      <span class="p-num">{number}</span>
    </>
  )}
  {emirate === 'Abu Dhabi' && (
    <>
      <span class="p-ad-block"><span class="p-ad-code">{code}</span></span>
      <span class="p-ad-stack" aria-hidden="true"><span class="ar" dir="rtl" lang="ar">الإمارات</span><span class="ar" dir="rtl" lang="ar">أبوظبي</span><span class="en">U.A.E A.D</span></span>
      <span class="p-num">{number}</span>
    </>
  )}
  {emirate === 'Sharjah' && (
    <>
      <span class="p-code p-code-grey">{code}</span>
      <span class="p-shj-stack" aria-hidden="true"><span class="ar" dir="rtl" lang="ar">الشــارقة</span><span class="en">U.A.E <span class="ar-small" dir="rtl" lang="ar">م.ع.ا</span></span><span class="en2">SHARJAH</span></span>
      <span class="p-num p-num-grey">{number}</span>
    </>
  )}
  {emirate === 'Fujairah' && (
    <>
      <span class="p-code p-code-grey">{code}</span>
      <span class="p-fuj-stack" aria-hidden="true"><span class="ar" dir="rtl" lang="ar">الفجيرة</span><span class="en">FUJAIRAH</span><span class="en">U.A.E</span></span>
      <span class="p-num p-num-grey">{number}</span>
    </>
  )}
</div>

<style>
  .plate-uae {
    --w: calc(220px * var(--s));
    display: inline-flex; align-items: center; gap: calc(10px * var(--s));
    width: var(--w); height: calc(50px * var(--s)); padding-inline: calc(10px * var(--s));
    background: #fff; border: calc(2px * var(--s)) solid #0a0a0a; border-radius: calc(5px * var(--s));
    color: #0a0a0a; font-family: "Arial Narrow", "Helvetica Neue Condensed", "Roboto Condensed", Arial, sans-serif;
    font-weight: 700; white-space: nowrap; box-sizing: border-box; box-shadow: 0 1px 2px rgba(0,0,0,.15);
  }
  [data-emirate="Sharjah"], [data-emirate="Fujairah"] { background: #e9eaec; border-color: #2a2a2a; }
  .p-num { margin-inline-start: auto; font-size: calc(30px * var(--s)); line-height: 1; letter-spacing: calc(1px * var(--s)); font-stretch: condensed; }
  .p-code { font-size: calc(22px * var(--s)); line-height: 1; }
  .p-left { display: flex; flex-direction: column; align-items: flex-start; line-height: 1; gap: calc(2px * var(--s)); }
  /* Dubai lettering: blue/magenta stylised */
  .p-dubai { display: inline-flex; font-size: calc(13px * var(--s)); font-weight: 900; letter-spacing: calc(-0.5px * var(--s)); font-family: "Arial Black", Arial, sans-serif; }
  .p-dubai i { font-style: normal; color: #2446a8; }
  .p-dubai i:nth-child(2), .p-dubai i:nth-child(4) { color: #d2308c; }
  /* Abu Dhabi */
  .p-ad-block { display: inline-flex; align-items: center; justify-content: center; height: 100%; margin-inline-start: calc(-10px * var(--s)); padding-inline: calc(8px * var(--s)); background: #d32027; color: #fff; border-start-start-radius: calc(3px * var(--s)); border-end-start-radius: calc(3px * var(--s)); }
  .p-ad-code { font-size: calc(26px * var(--s)); line-height: 1; font-weight: 800; }
  .p-ad-stack, .p-shj-stack, .p-fuj-stack { display: flex; flex-direction: column; align-items: center; line-height: 1.05; }
  .p-ad-stack .ar { font-size: calc(8px * var(--s)); font-weight: 600; font-family: "Noto Naskh Arabic", "Geeza Pro", "Segoe UI", Tahoma, sans-serif; }
  .p-ad-stack .en { font-size: calc(8px * var(--s)); letter-spacing: calc(0.6px * var(--s)); font-family: Arial, sans-serif; }
  /* Sharjah */
  .p-shj-stack .ar { font-size: calc(13px * var(--s)); font-weight: 700; font-family: "Noto Naskh Arabic", "Geeza Pro", "Segoe UI", Tahoma, sans-serif; }
  .p-shj-stack .en { font-size: calc(8px * var(--s)); font-family: Arial, sans-serif; letter-spacing: calc(0.4px * var(--s)); }
  .p-shj-stack .ar-small { font-size: calc(7px * var(--s)); margin-inline-start: calc(3px * var(--s)); }
  .p-shj-stack .en2 { font-size: calc(8px * var(--s)); font-family: Arial, sans-serif; letter-spacing: calc(0.8px * var(--s)); }
  /* Fujairah */
  .p-fuj-stack .ar { font-size: calc(14px * var(--s)); font-weight: 700; font-family: "Noto Naskh Arabic", "Geeza Pro", "Segoe UI", Tahoma, sans-serif; }
  .p-fuj-stack .en { font-size: calc(6px * var(--s)); font-family: Arial, sans-serif; letter-spacing: calc(1px * var(--s)); }
  .p-code-grey, .p-num-grey { color: #2a2a2a; }
</style>
