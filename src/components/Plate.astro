---
/** UAE number plate rendered in HTML (no logos). Formats follow the common emirate layouts. */
interface Props { emirate: 'Dubai' | 'Abu Dhabi' | 'Sharjah' | 'Fujairah'; code: string; number: string; class?: string }
const { emirate, code, number, class: className = '' } = Astro.props;
const arabic: Record<string, string> = { Dubai: 'دبي', 'Abu Dhabi': 'أبوظبي', Sharjah: 'الشارقة', Fujairah: 'الفجيرة' };
---
<div class:list={['plate-uae inline-flex items-center gap-3 rounded-[6px] border-[1.5px] border-ink bg-white px-3 py-1.5 text-ink', className]} role="img" aria-label={`${emirate} plate ${code} ${number}`}>
  <span class="text-[18px] font-bold leading-none tracking-[0.02em]">{code}</span>
  <span class="flex flex-col items-center leading-none">
    <span class="text-[9px] font-semibold uppercase tracking-[0.14em]">{emirate}</span>
    <span class="mt-0.5 text-[9px] leading-none" dir="rtl" lang="ar">{arabic[emirate]}</span>
  </span>
  <span class="ms-1 text-[22px] font-bold leading-none tabular-nums tracking-[0.06em]">{number}</span>
</div>
