---
/** Guest receipt mockup (demo data), used in §6 Money. */
import Icon from './Icon.astro';
const lines = [
  ['Valet', '40 AED'],
  ['Validation · Restaurant', '−40 AED'],
  ['Tip to Y. Khan', '80 AED'],
];
---
<div class="glass-card w-full max-w-[320px] p-5 text-[13px]" aria-label="Receipt, demo data">
  <div class="flex items-center justify-between">
    <span class="t-wordmark text-[13px]">The Marquee</span>
    <span class="t-caption">Receipt</span>
  </div>
  <p class="mt-4 text-[15px] font-semibold">Land Rover Defender</p>
  <p class="text-ink-2">M 95378 · Ticket V777</p>
  <div class="mt-3 grid grid-cols-2 gap-2 text-[12px]">
    <div class="rounded-card bg-field px-3 py-2"><p class="t-caption !text-[10px] uppercase tracking-[0.1em]">In</p><p class="font-medium">01:06 AM</p></div>
    <div class="rounded-card bg-field px-3 py-2"><p class="t-caption !text-[10px] uppercase tracking-[0.1em]">Out</p><p class="font-medium">02:14 AM</p></div>
  </div>
  <ul class="mt-4 divide-y divide-line border-y border-line">
    {lines.map(([k, v]) => <li class="flex items-center justify-between py-2"><span class="text-ink-2">{k}</span><span class="tabular-nums">{v}</span></li>)}
  </ul>
  <div class="mt-3 flex items-center justify-between text-[15px] font-semibold"><span>Paid</span><span class="tabular-nums">80 AED</span></div>
  <p class="mt-2 inline-flex items-center gap-1.5 text-ink-2"><Icon name="apple" size={13} /> Apple Pay · sent to +971 58 ···· ····</p>
</div>
