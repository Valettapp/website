---
/**
 * Scan screen: a live camera feed on a real Defender (the plate photo from the guest page),
 * plate detection box → "Scanning vehicle…" → plate, make, model, colour fill in.
 * Loops while visible; tap to replay. Reduced motion renders the final state.
 */
import { Picture } from 'astro:assets';
import carScan from '../assets/car-scan.jpg';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Plate from './Plate.astro';
import IosBar from './IosBar.astro';
/** device: a real iPhone body with status bar and Dynamic Island. */
interface Props { class?: string; framed?: boolean; dark?: boolean; device?: boolean }
const { class: className = '', framed = true, dark = false, device = false } = Astro.props;
const fields = [
  ['Plate', 'DUBAI M 95378'],
  ['Make', 'Land Rover'],
  ['Model', 'Defender'],
  ['Colour', 'White'],
];
---
<div class:list={[framed ? (device ? 'phone-device w-full max-w-[300px]' : dark ? 'phone-frame phone-frame-dark w-full max-w-[300px]' : 'phone-frame w-full max-w-[300px]') : '', className]}>
  <div class:list={['scan bg-ink text-white', framed ? 'phone-screen' : 'relative aspect-[9/16] overflow-hidden rounded-[14px]']} data-scan data-phase="0" role="img" aria-label="Staff app camera: one photo of the car reads the plate, make, model and colour">
    {/* Camera feed: the Defender, plate M 95378. Viewfinder and plate box ride with the feed. */}
    <div class="scan-feed absolute inset-0">
      <Picture src={carScan} formats={['avif', 'webp']} widths={[380, 760]} sizes="300px" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
      <div class="scan-frame absolute left-[8%] right-[8%] top-[43%] z-10 aspect-[4/3]">
        <div class="scan-corners absolute inset-0"></div>
        <div class="scan-line absolute inset-x-2 top-0 h-px bg-gold/90 shadow-[0_0_14px_2px_rgba(197,162,83,.55)]"></div>
      </div>
      {/* The measured plate: 20–80 % across, 54.7–62 % down, plus a little padding */}
      <div class="scan-plate absolute left-[18.5%] top-[53%] z-10 h-[10.5%] w-[63%] rounded-[4px] border-2 border-white/60" data-plate-box>
        <span class="scan-plate-tag absolute -top-6 right-0 rounded-[4px] bg-gold px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink">Plate</span>
      </div>
    </div>
    <div class="scan-shade pointer-events-none absolute inset-0" aria-hidden="true"></div>

    {device && <IosBar time="1:05" />}
    <div class:list={['absolute inset-x-0 top-0 z-10 flex items-center justify-between px-5', device ? 'pt-[52px]' : 'pt-5']}>
      <Wordmark variant="serif" class="text-[12px] text-white/90" />
      {!device && <span class="text-[11px] text-white/70">01:05</span>}
    </div>

    {/* Captions */}
    <div class="absolute inset-x-5 top-[77%] z-10 text-center">
      <p class="scan-t0 text-[15px] font-medium drop-shadow">Take vehicle photo</p>
      <p class="scan-t0 mt-1 text-[12px] text-white/70">Frame the number plate</p>
      <p class="scan-t1 text-[15px] font-medium"><span class="inline-flex items-center gap-2"><span class="scan-dot size-1.5 rounded-full bg-gold"></span>Scanning vehicle…</span></p>
    </div>

    {/* Results sheet */}
    <div class="scan-results absolute inset-x-0 bottom-0 z-10 rounded-t-[22px] bg-ink/95 px-5 pb-5 pt-4">
      <div class="mx-auto mb-3 h-1 w-9 rounded-pill bg-white/20"></div>
      <ul class="flex flex-col gap-1.5 text-[12px]">
        {fields.map(([k, v], i) => (
          <li class="scan-row flex items-center justify-between rounded-[8px] border border-white/10 bg-white/[.06] px-3 py-2" style={`--i:${i}`}>
            <span class="text-white/55">{k}</span>{k === 'Plate' ? <Plate emirate="Dubai" code="M" number="95378" scale={0.55} /> : <span class="font-medium tracking-[0.02em]">{v}</span>}
          </li>
        ))}
      </ul>
      <span class="scan-done mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-pill bg-white px-4 py-2.5 text-[13px] font-medium text-ink"><Icon name="check" size={13} /> Vehicle recognised · Continue</span>
    </div>

    {/* Shutter */}
    <div class="scan-shutter absolute inset-x-0 bottom-5 z-10 flex justify-center">
      <span class="inline-flex size-14 items-center justify-center rounded-full border-2 border-white/90"><span class="size-11 rounded-full bg-white/95"></span></span>
    </div>
    <button type="button" class="absolute inset-0 z-20 cursor-pointer" aria-label="Replay scan animation" data-replay></button>
  </div>
</div>

<style>
  .scan-shade { background: linear-gradient(to bottom, rgba(0,0,0,.2), rgba(0,0,0,0) 30%, rgba(0,0,0,0) 62%, rgba(10,10,10,.92) 84%, #0a0a0a 100%); }
  .scan-corners { background:
    linear-gradient(#fff,#fff) top left/20px 2px no-repeat, linear-gradient(#fff,#fff) top left/2px 20px no-repeat,
    linear-gradient(#fff,#fff) top right/20px 2px no-repeat, linear-gradient(#fff,#fff) top right/2px 20px no-repeat,
    linear-gradient(#fff,#fff) bottom left/20px 2px no-repeat, linear-gradient(#fff,#fff) bottom left/2px 20px no-repeat,
    linear-gradient(#fff,#fff) bottom right/20px 2px no-repeat, linear-gradient(#fff,#fff) bottom right/2px 20px no-repeat;
    opacity: .95; }
  .scan-line, .scan-t1, .scan-results, .scan-done, .scan-plate-tag { opacity: 0; }
  .scan-plate { transition: border-color 300ms ease, box-shadow 300ms ease; }
  .scan-row { opacity: 0; transform: translateY(6px); }
  .scan-results { transform: translateY(16px); transition: opacity 320ms ease, transform 320ms ease; }
  /* phase 1: scanning */
  [data-phase="1"] .scan-t0, [data-phase="2"] .scan-t0 { opacity: 0; }
  [data-phase="1"] .scan-t1 { opacity: 1; }
  [data-phase="1"] .scan-line { opacity: 1; animation: v-scanline 1.4s ease-in-out infinite alternate; }
  [data-phase="1"] .scan-plate, [data-phase="2"] .scan-plate { border-color: #c5a253; box-shadow: 0 0 0 2px rgba(197,162,83,.25), 0 0 24px rgba(197,162,83,.35); }
  [data-phase="1"] .scan-plate-tag, [data-phase="2"] .scan-plate-tag { opacity: 1; transition: opacity 200ms ease 200ms; }
  [data-phase="1"] .scan-dot { animation: v-pulse 1s ease-in-out infinite; }
  /* phase 2: results */
  [data-phase="2"] .scan-results { opacity: 1; transform: none; }
  [data-phase="2"] .scan-row { opacity: 1; transform: none; transition: opacity 300ms ease, transform 300ms ease; transition-delay: calc(var(--i) * 160ms); }
  [data-phase="2"] .scan-shutter { display: none; }
  [data-phase="2"] .scan-done { opacity: 1; transition: opacity 300ms ease 760ms; }
  [data-phase="2"] .scan-t1 { opacity: 0; }
  .scan-feed { transition: transform 450ms cubic-bezier(.2,.8,.2,1); }
  [data-phase="2"] .scan-feed { transform: translateY(-30%); } /* clears the results sheet on the smallest phones */
  .scan-t0, .scan-t1, .scan-line { transition: opacity 300ms ease; }
  .scan-t1 { position: absolute; inset-inline: 0; top: 0; }
  @media (prefers-reduced-motion: reduce) { .scan-line { animation: none !important; } }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-scan]').forEach((el) => {
    let timers: number[] = [];
    let visible = false;
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const play = () => {
      clear();
      if (reduce) { el.dataset.phase = '2'; return; }
      el.dataset.phase = '0';
      timers.push(window.setTimeout(() => (el.dataset.phase = '1'), 1500));
      timers.push(window.setTimeout(() => (el.dataset.phase = '2'), 3300));
      timers.push(window.setTimeout(() => { if (visible) play(); }, 8000));
    };
    el.querySelector('[data-replay]')?.addEventListener('click', play);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => { visible = e.isIntersecting; if (visible) play(); else clear(); });
      }, { threshold: 0.3 }).observe(el);
    } else play();
  });
</script>
