---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  center?: boolean;
  lede?: string;
  class?: string;
}
const { eyebrow, title, id, center = false, lede, class: className = '' } = Astro.props;
---
<header class:list={['flex flex-col gap-4', center ? 'items-center text-center' : 'items-start text-start', className]}>
  {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
  <h2 id={id} class="t-h2 max-w-[18em]">{title}</h2>
  {lede && <p class="t-body max-w-[34em] text-ink-2">{lede}</p>}
</header>
