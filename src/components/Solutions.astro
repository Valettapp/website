---
/** Cross-links between the keyword pages and the home page. */
import { solutions } from '../data/solutions';
interface Props { current?: string }
const { current } = Astro.props;
const others = solutions.filter((s) => s.slug !== current);
---
<section class="border-t border-line py-12 md:py-16" aria-label="Valett for other venues">
  <div class="container-page">
    <p class="t-eyebrow">Valett for every door</p>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-[16px] font-medium">
      {current && <li><a class="hover:text-ink-2 transition-colors" href="/">Overview</a></li>}
      {others.map((s) => (
        <li><a class="hover:text-ink-2 transition-colors" href={`/${s.slug}`}>{s.nav}</a></li>
      ))}
    </ul>
  </div>
</section>
