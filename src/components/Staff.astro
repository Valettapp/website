---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import ScanAnimation from './ScanAnimation.astro';
import StaffScreen from './StaffScreen.astro';
import KeyBoard from './KeyBoard.astro';
import BrowserFrame from './BrowserFrame.astro';
const steps = [
  { title: 'Photograph.', body: 'One photo reads the plate, make, model and colour. No typing at the door.' },
  { title: 'Ticket.', body: 'Code and QR appear instantly: show it, send it by SMS, or print.' },
  { title: 'Park.', body: 'Zone and bay recorded, keys tracked, damage walkaround with time-stamped photos.' },
];
---
<section data-reveal-group id="staff" class="section-pad scroll-mt-20" aria-labelledby="staff-title">
  <div class="container-page">
    <SectionHead id="staff-title" eyebrow="The staff app" title="Forty seconds from arrival to parked. All of it on the record." />

    <ol class="snap-row mt-16 md:mt-24 md:grid md:grid-cols-3 md:gap-8" data-reveal>
      {steps.map((s, i) => (
        <li class="snap-item flex flex-col gap-6">
          <div class="rounded-frame bg-field px-6 py-8 flex justify-center">
            {i === 0 ? <ScanAnimation /> : i === 1 ? <StaffScreen screen="ticket" /> : <StaffScreen screen="park" />}
          </div>
          <div class="flex flex-col gap-2">
            <p class="t-eyebrow">0{i + 1}</p>
            <h3 class="t-h3">{s.title}</h3>
            <p class="t-body text-ink-2">{s.body} <Pill status="live" class="ms-1 align-[2px]" /></p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-20 grid items-center gap-12 md:mt-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5 flex justify-center lg:justify-start">
        <div class="rounded-frame bg-field px-6 py-8 w-full flex justify-center">
          <StaffScreen screen="request" />
        </div>
      </div>
      <div class="lg:col-span-7 flex flex-col gap-4">
        <p class="t-eyebrow">04</p>
        <h3 class="t-h3 max-w-[22em]">“New request, just now. Land Rover Defender, Zone P3, Bay 55. On my way.”</h3>
        <p class="t-body measure text-ink-2">The driver taps once and the guest’s page moves. <Pill status="live" class="ms-1 align-[2px]" /></p>
      </div>
    </div>

    <div class="mt-20 md:mt-28">
      <div class="mb-8 flex flex-col gap-3">
        <p class="t-eyebrow">The key board</p>
        <h3 class="t-h3 max-w-[24em]">Every ticket, every promise, on one board. When a request runs late, the shift manager knows before the guest does. <Pill status="live" class="ms-1 align-[3px]" /></h3>
      </div>
      <div class="rounded-frame bg-field p-3 md:p-8">
        <BrowserFrame url="board.valettuae.com/the-marquee">
          <KeyBoard />
        </BrowserFrame>
      </div>
    </div>
  </div>
</section>
