---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import ScanAnimation from './ScanAnimation.astro';
import StaffScreen from './StaffScreen.astro';
import BrowserFrame from './BrowserFrame.astro';
import Ambient from './Ambient.astro';
import { Picture } from 'astro:assets';
import keyController from '../assets/reports/key-controller-full.jpg';
const steps = [
  { title: 'Photograph.', body: 'One photo reads the plate, make, model and colour. No typing at the door.' },
  { title: 'Ticket.', body: 'Code and QR appear instantly: show it, send it by SMS, or print.' },
  { title: 'Park.', body: 'Zone and bay recorded, keys tracked, damage walkaround with time-stamped photos.' },
];
---
<section data-reveal-group id="staff" class="section-pad scroll-mt-20" aria-labelledby="staff-title">
  <div class="container-page">
    <SectionHead id="staff-title" eyebrow="The staff app" title="Forty seconds from arrival to parked. All of it on the record." />

    <ol class="snap-row mt-16 md:mt-24 md:grid md:grid-cols-3 md:gap-8" data-reveal-stagger="scale">
      {steps.map((s, i) => (
        <li class="snap-item flex flex-col gap-6">
          <div class="rounded-frame bg-field px-6 py-8 flex justify-center">
            {i === 0 ? <ScanAnimation device class="phone-fit" /> : i === 1 ? <StaffScreen device screen="ticket" class="phone-fit" /> : <StaffScreen device screen="park" class="phone-fit" />}
          </div>
          <div class="flex flex-col gap-2">
            <p class="t-eyebrow">0{i + 1}</p>
            <h3 class="t-h3">{s.title}</h3>
            <p class="t-body text-ink-2">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-20 grid items-center gap-12 md:mt-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5 flex justify-center lg:justify-start" data-reveal="left">
        <div class="rounded-frame bg-field px-6 py-8 w-full flex justify-center">
          <StaffScreen device screen="request" class="phone-fit" />
        </div>
      </div>
      <div class="lg:col-span-7 flex flex-col gap-4" data-reveal="right">
        <p class="t-eyebrow">04</p>
        <h3 class="t-h3 max-w-[22em]">“New request, just now. Land Rover Defender, Zone P3, Bay 55. On my way.”</h3>
        <p class="t-body measure text-ink-2">The driver taps once and the guest’s page moves.</p>
      </div>
    </div>

    <div class="relative mt-20 md:mt-28" data-reveal>
      <Ambient variant="wide" class="-inset-y-[10%]" />
      <div class="mb-8 flex flex-col gap-3">
        <p class="t-eyebrow">The key controller</p>
        <h3 class="t-h3 max-w-[26em]">Every ticket on one board, from checked in to at the podium. The shift manager sees who is on, what is requested and what is running late.</h3>
      </div>
      <div class="glass-panel !rounded-frame p-3 md:p-8">
        <BrowserFrame url="admin.valett.si/key-controller">
          <Picture src={keyController} formats={['avif', 'webp']} widths={[800, 1200, 1800]} sizes="(min-width: 1280px) 1150px, 94vw" alt="Key controller board: columns for checked in, parked, requested, with driver, en route and at podium, each ticket with its hook, car and timing." class="block w-full" loading="lazy" decoding="async" />
        </BrowserFrame>
      </div>
    </div>
  </div>
</section>
