---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import ScanAnimation from './ScanAnimation.astro';
import Plate from './Plate.astro';
import Icon from './Icon.astro';
import SampleLabel from './SampleLabel.astro';
import type { Status } from '../data/site';
const rows: { label: string; status: Status }[] = [
  { label: 'Vehicle recognition from one photo', status: 'live' },
  { label: 'White-label branding per venue, English and Arabic', status: 'live' },
  { label: 'Fully configurable rules, tiers and validation', status: 'live' },
  { label: 'AI scanning camera on every driver’s device', status: 'live' }, // pending Leon: wording
  { label: 'Demand prediction and automatic driver assignment', status: 'dev' },
];
// Demo plates in the common emirate formats; the recognition output beside each.
const reads = [
  { emirate: 'Dubai', code: 'M', number: '95378', out: 'Land Rover Defender · White' },
  { emirate: 'Abu Dhabi', code: '11', number: '42985', out: 'Mercedes G 63 · Black' },
  { emirate: 'Sharjah', code: '1', number: '12345', out: 'Porsche Cayenne · Grey' },
  { emirate: 'Fujairah', code: 'J', number: '1986', out: 'Range Rover Sport · Silver' },
] as const;
---
<section data-reveal-group id="technology" class="section-pad scroll-mt-20" aria-labelledby="technology-title">
  <div class="container-page">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="flex flex-col gap-6 lg:col-span-7">
        <SectionHead id="technology-title" eyebrow="AI-led from the first line of code" title="A valet operation that learns." />
        <p class="t-body measure">
          Valett is an AI company that happens to park cars. Vehicle recognition reads every plate, make, model and colour from one photo. Every venue runs its own white-label brand on the guest page. Every rule, from VIP tiers to validation to residents’ plans, is configurable without a developer. We are building the operation that runs itself: predicting demand, assigning drivers, flagging incidents before a guest notices.
        </p>
        <ul class="mt-4 max-w-[36em]">
          {rows.map((r) => (
            <li class="hairline-t flex items-center justify-between gap-6 py-4">
              <span class="text-[16px] md:text-[17px]">{r.label}</span>
              <Pill status={r.status} />
            </li>
          ))}
          <li class="hairline-t"></li>
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-frame bg-ink p-6 md:p-10 flex flex-col items-center gap-6">
          <ScanAnimation dark />
          <p class="t-caption text-center text-white/60">The camera in the staff app, on the driver’s own phone. One photo: plate, make, model and colour.</p>
        </div>
      </div>
    </div>

    {/* Plate recognition */}
    <div class="mt-20 md:mt-28" data-reveal>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-3">
          <p class="t-eyebrow">Plate recognition</p>
          <h3 class="t-h3 max-w-[26em]">Reads the plate as the valet frames it: emirate, code and number, then the make, model and colour of the car behind it.</h3>
        </div>
        <SampleLabel text="Demo plates" class="md:pb-1" />
      </div>
      <ul class="snap-row mt-10 sm:grid sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {reads.map((r) => (
          <li class="snap-item glass-card flex flex-col gap-4 p-5">
            <div class="flex justify-center rounded-card bg-field py-6"><Plate emirate={r.emirate} code={r.code} number={r.number} /></div>
            <div class="flex items-start gap-2.5 text-[13px]">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-gold text-gold"><Icon name="check" size={11} /></span>
              <span><strong class="block font-semibold">{r.emirate} · {r.code} {r.number}</strong><span class="text-ink-2">{r.out}</span></span>
            </div>
          </li>
        ))}
      </ul>
      <p class="t-caption mt-6 max-w-[40em]">Recognition runs on the photo the valet takes at the door, in daylight and at night. Plate formats shown are demo data. <Pill status="live" class="ms-1 align-[1px]" /></p>
    </div>
  </div>
</section>
