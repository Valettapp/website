---
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import ScanAnimation from './ScanAnimation.astro';
import type { Status } from '../data/site';
const rows: { label: string; status: Status; note?: string }[] = [
  { label: 'Vehicle recognition from one photo', status: 'live' },
  { label: 'White-label branding per venue, English and Arabic', status: 'live' },
  { label: 'Fully configurable rules, tiers and validation', status: 'live' },
  { label: 'AI scanning camera on every driver’s device', status: 'live', note: 'wording pending' }, // pending Leon: wording
  { label: 'Demand prediction and automatic driver assignment', status: 'dev' },
];
---
<section id="technology" class="section-pad scroll-mt-20" aria-labelledby="technology-title">
  <div class="container-page">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="flex flex-col gap-6 lg:col-span-7">
        <SectionHead id="technology-title" eyebrow="AI-led from the first line of code" title="A valet operation that learns." />
        <p class="t-body measure">
          Valett is an AI company that happens to park cars. Vehicle recognition reads every plate, make, model and colour from one photo. Every venue runs its own white-label brand on the guest page. Every rule, from VIP tiers to validation to residents’ plans, is configurable without a developer. We are building the operation that runs itself: predicting demand, assigning drivers, flagging incidents before a guest notices.
        </p>
        <ul class="mt-4 max-w-[36em]">
          {rows.map((r) => (
            <li class="hairline-t flex items-center justify-between gap-6 py-4">
              <span class="text-[16px] md:text-[17px]">{r.label}</span>
              <Pill status={r.status} />
            </li>
          ))}
          <li class="hairline-t"></li>
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-frame bg-ink p-6 md:p-10 flex flex-col items-center gap-6">
          <ScanAnimation dark />
          <p class="t-caption text-center text-white/50">One photo. Plate, make, model and colour, in under a second.</p>
        </div>
      </div>
    </div>
  </div>
</section>
