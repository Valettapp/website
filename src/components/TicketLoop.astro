---
/**
 * "From the valet's phone to the guest's." Two iPhones turn to face the camera: the valet's (V777 and its QR)
 * and the guest's (their car, Request My Car). All digital, no paper anywhere. The end hold is the real
 * interface, composited onto the phones, not generated. Source: scripts/film/handoff.md.
 */
import LoopFigure from './LoopFigure.astro';
---
<section data-reveal-group id="handoff" class="section-pad !pb-0 scroll-mt-20" aria-labelledby="handoff-title">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-12">
      <h2 id="handoff-title" class="t-h2 max-w-[12em]">From the valet’s phone to the guest’s.</h2>
      <p class="t-body max-w-[26em] text-ink-2">The valet photographs the car. The guest scans the code on the valet’s phone, and their car is on their own screen, with a button to bring it back. No paper. No app to download.</p>
    </div>
    <LoopFigure
      class="mt-10 md:mt-14"
      name="handoff"
      label="Two phones turn to face the camera: the valet’s shows ticket V777 and its QR code, the guest’s shows their Land Rover Defender with a Request My Car button."
    />
  </div>
</section>
