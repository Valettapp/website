---
/**
 * "From the valet's phone to the guest's." A short silent loop: two iPhones turn to face the camera, the
 * valet's (V777 and its QR) and the guest's (their car, Request My Car). All digital, no paper anywhere.
 * The end hold is the real interface, composited onto the phones, not generated.
 * Muted, looping, plays only while on screen; nothing downloads until it nears the viewport.
 * Reduced motion: no playback, the poster shows the final frame (both screens).
 * Source: scripts/film/handoff.md.
 */
---
<section data-reveal-group id="handoff" class="section-pad !pb-0 scroll-mt-20" aria-labelledby="handoff-title">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-12">
      <h2 id="handoff-title" class="t-h2 max-w-[12em]">From the valet’s phone to the guest’s.</h2>
      <p class="t-body max-w-[26em] text-ink-2">The valet photographs the car. The guest scans the code on the valet’s phone, and their car is on their own screen, with a button to bring it back. No paper. No app to download.</p>
    </div>
    <figure class="glass mt-10 rounded-frame p-2 md:mt-14 md:p-3" data-reveal>
      <div class="relative aspect-square overflow-hidden rounded-[14px] bg-[#e9e9e6] md:aspect-video">
        <video
          class="absolute inset-0 h-full w-full object-cover"
          muted
          loop
          playsinline
          preload="none"
          disableremoteplayback
          aria-label="Two phones turn to face the camera: the valet’s shows ticket V777 and its QR code, the guest’s shows their Land Rover Defender with a Request My Car button."
          data-ticket-loop
          data-poster-wide="/film/handoff-start-16x9.webp"
          data-poster-tall="/film/handoff-start-1x1.webp"
          data-poster-wide-end="/film/handoff-end-16x9.webp"
          data-poster-tall-end="/film/handoff-end-1x1.webp"
        >
          <source src="/film/handoff-1x1.mp4" type="video/mp4" media="(max-width: 767px)" />
          <source src="/film/handoff-16x9.mp4" type="video/mp4" />
        </video>
      </div>
    </figure>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-ticket-loop]');
  if (video) {
    const tall = window.matchMedia('(max-width: 767px)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const d = video.dataset;
    // Reduced motion: no playback, show both screens. Otherwise the opening frame (phones edge-on).
    video.poster = (reduce ? (tall ? d.posterTallEnd : d.posterWideEnd) : (tall ? d.posterTall : d.posterWide)) || '';
    if (!reduce && 'IntersectionObserver' in window) {
      let started = false;
      new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            if (!started) { started = true; video.preload = 'auto'; video.load(); }
            video.play().catch(() => {});
          } else if (started) video.pause();
        }
      }, { threshold: 0.35 }).observe(video);
    }
  }
</script>
