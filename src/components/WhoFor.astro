---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import Ambient from './Ambient.astro';
// Fictional venues: the guest page carries each venue's own wordmark (white-label).
const doors = [
  { venue: 'The Marquee', title: 'Hotels and resorts', body: 'The guest page carries the hotel’s name, not ours. Concierge sees every car.', status: 'Parked · 01:06 AM', line: 'Validation · Ask your concierge' },
  { venue: 'Arcadia Mall', title: 'Malls', body: 'Thousands of tickets a day, validation by store, no paper to reconcile.', status: 'Parked · Level 2 · 14:22', line: 'Validated · Maison du Thé' },
  { venue: 'Maison Lune', title: 'Restaurants', body: 'Guests request from the table and walk out to a car at the kerb.', status: 'Request received · 22:48', line: 'At the kerb in 4 min' },
  { venue: 'One Marina', title: 'Residences', body: 'Residents’ permanent plans, visitor tickets, one record per building.', status: 'Resident · Apt 1204', line: 'Visitor ticket · until 23:00' },
];
---
<section data-reveal-group id="who" class="section-pad scroll-mt-20" aria-labelledby="who-title">
  <div class="container-page">
    <SectionHead id="who-title" eyebrow="Who it’s for" title="One system, four kinds of door." />
    <div class="relative mt-14 md:mt-20"><Ambient variant="wide" class="-inset-y-[20%]" />
    <ul class="snap-row sm:grid sm:grid-cols-2 sm:gap-6 lg:grid-cols-4" data-reveal>
      {doors.map((d) => (
        <li class="snap-item flex flex-col">
          <div class="glass-card !rounded-frame px-6 pt-6 pb-0 md:px-8 md:pt-8">
            <div class="phone-frame mx-auto w-full max-w-[220px] !rounded-b-none !border-b-0 !pb-0" aria-hidden="true">
              <div class="rounded-t-[26px] bg-field px-4 pt-4 pb-5 text-center">
                <p class="t-wordmark text-[11px]">{d.venue}</p>
                <p class="mt-5 text-[9px] font-medium uppercase tracking-[0.14em] text-ink-2">{d.status}</p>
                <p class="mt-1.5 text-[14px] font-semibold tracking-[-0.01em]">Land Rover Defender</p>
                <p class="mt-2 inline-flex items-center gap-1 rounded-pill bg-white px-2 py-1 text-[9px] text-ink-2"><Icon name="check" size={9} class="text-gold" />{d.line}</p>
              </div>
            </div>
          </div>
          <div class="flex flex-1 flex-col gap-2 px-1 pt-5">
            <h3 class="t-h3">{d.title}</h3>
            <p class="text-[16px] leading-relaxed text-ink-2">{d.body}</p>
          </div>
        </li>
      ))}
    </ul>
    </div>
  </div>
</section>
