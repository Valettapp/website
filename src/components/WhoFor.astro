---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import Ambient from './Ambient.astro';
import IosBar from './IosBar.astro';
// Fictional venues: the guest page carries each venue's own wordmark (white-label).
const doors = [
  { venue: 'The Marquee', href: '/hotel-valet-app', title: 'Hotels and resorts', body: 'The guest page carries the hotel’s name, not ours. Concierge sees every car.', status: 'Parked · 01:06 AM', line: 'Validation · Ask your concierge' },
  { venue: 'Arcadia Mall', href: '/mall-valet-parking-system', title: 'Malls', body: 'Thousands of tickets a day, validation by store, no paper to reconcile.', status: 'Parked · Level 2 · 14:22', line: 'Validated · Maison du Thé' },
  { venue: 'Maison Lune', href: '/restaurant-valet-service', title: 'Restaurants', body: 'Guests request from the table and walk out to a car at the kerb.', status: 'Request received · 22:48', line: 'At the kerb in 4 min' },
  { venue: 'One Marina', href: '/residential-valet-parking', title: 'Residences', body: 'Residents’ permanent plans, visitor tickets, one record per building.', status: 'Resident · Apt 1204', line: 'Visitor ticket · until 23:00' },
];
---
<section data-reveal-group id="who" class="section-pad !pb-16 md:!pb-24 scroll-mt-20" aria-labelledby="who-title">
  <div class="container-page">
    <SectionHead id="who-title" eyebrow="Who it’s for" title="One system, four kinds of door." />
    <div class="relative mt-14 md:mt-20"><Ambient variant="wide" class="-inset-y-[20%]" />
    <ul class="snap-row sm:grid sm:grid-cols-2 sm:gap-6 lg:grid-cols-4" data-reveal-stagger="scale">
      {doors.map((d) => (
        <li class="snap-item flex flex-col">
          <div class="glass-card !rounded-frame overflow-hidden px-6 pt-6 pb-0 md:px-8 md:pt-8">
            <div class="door-wrap" aria-hidden="true">
              <div class="door-phone phone-device">
                <div class="door-screen bg-field">
                  <IosBar time="1:06" tone="dark" />
                  <p class="t-wordmark pt-[58px] text-[15px]">{d.venue}</p>
                  <p class="mt-6 text-[12px] font-medium uppercase tracking-[0.14em] text-ink-2">{d.status}</p>
                  <p class="mt-2 text-[19px] font-semibold tracking-[-0.01em]">Land Rover Defender</p>
                  <p class="mt-3 inline-flex items-center gap-1.5 rounded-pill bg-white px-3 py-1.5 text-[12px] text-ink-2"><Icon name="check" size={12} class="text-gold" />{d.line}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="flex flex-1 flex-col gap-2 px-1 pt-5">
            <h3 class="t-h3"><a class="hover:text-ink-2 transition-colors" href={d.href}>{d.title}</a></h3>
            <p class="text-[16px] leading-relaxed text-ink-2">{d.body}</p>
            <a class="mt-1 inline-flex items-center gap-1.5 text-[14px] font-medium text-ink hover:text-ink-2 transition-colors" href={d.href}>Valett for {d.title.toLowerCase()} <Icon name="chevron" size={12} class="-rotate-90" /></a>
          </div>
        </li>
      ))}
    </ul>
    </div>
  </div>
</section>

<style>
  /* The top half of a real iPhone (status bar, Dynamic Island), drawn at 300 px and scaled to 220 px with the
     scale property (never zoom: Safari zooms text and boxes differently). */
  .door-wrap { display: flex; height: 170px; align-items: flex-start; justify-content: center; }
  .door-phone { width: 300px; flex-shrink: 0; transform-origin: 50% 0; scale: 0.7333; padding-bottom: 0; border-end-start-radius: 0; border-end-end-radius: 0; }
  .door-screen { position: relative; height: 236px; overflow: hidden; border-radius: 39px 39px 0 0; text-align: center; }
</style>
