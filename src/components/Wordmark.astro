---
/**
 * Brand logo per the brand guidelines: "Valett." in a heavy sans, black on light, gold on dark.
 * `variant="serif"` is the letter-spaced VALETT the product screens use; keep it for those only.
 */
interface Props {
  class?: string;
  as?: 'span' | 'a' | 'div';
  href?: string;
  label?: string;
  variant?: 'brand' | 'serif';
}
const { class: className = '', as = 'span', href, label = 'Valett', variant = 'brand' } = Astro.props;
const Tag = as;
---
<Tag
  class:list={[variant === 'brand' ? 't-logo' : 't-wordmark', 'inline-block select-none', className]}
  {...(as === 'a' ? { href: href ?? '/', 'aria-label': `${label} — home` } : {})}
  translate="no"
>{variant === 'brand' ? 'Valett.' : 'Valett'}</Tag>
