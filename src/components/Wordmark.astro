---
/**
 * VALETT wordmark: letter-spaced Cormorant Garamond (site chrome, hero, product screens).
 * `variant="brand"` renders the brand-file "Valett." in a heavy sans; unused by default.
 */
interface Props {
  class?: string;
  as?: 'span' | 'a' | 'div';
  href?: string;
  label?: string;
  variant?: 'brand' | 'serif';
}
const { class: className = '', as = 'span', href, label = 'Valett', variant = 'serif' } = Astro.props;
const Tag = as;
---
<Tag
  class:list={[variant === 'brand' ? 't-logo' : 't-wordmark', 'inline-block select-none', className]}
  {...(as === 'a' ? { href: href ?? '/', 'aria-label': `${label} — home` } : {})}
  translate="no"
>{variant === 'brand' ? 'Valett.' : 'Valett'}</Tag>
