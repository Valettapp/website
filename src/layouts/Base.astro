---
import '../styles/global.css';
import { site } from '../data/site';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Extra JSON-LD objects for this page (FAQPage, WebPage, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
}
const { title = site.title, description = site.description, path = '/', schema = [] } = Astro.props;
const canonical = new URL(path, site.url).href;
const og = new URL('/og.png', site.url).href;
const logo = new URL('/icon-512.png', site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: 'Valett',
      legalName: 'Valett',
      alternateName: ['Valett Dubai', 'Valett UAE', 'Valett.ai', 'Valett valet'],
      knowsAbout: ['Valet parking', 'Digital valet', 'Valet management software', 'Hotel parking', 'Parking management', 'Vehicle recognition'],
      url: site.url,
      logo,
      email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: 'Q East by Alphabeta, Al Quoz', addressLocality: 'Dubai', addressCountry: 'AE' },
      areaServed: [{ '@type': 'City', name: 'Dubai' }, { '@type': 'Country', name: 'United Arab Emirates' }],
      ...(site.instagram ? { sameAs: [site.instagram] } : {}),
      slogan: site.tagline,
      description: site.description,
      foundingDate: '2025',
      foundingLocation: { '@type': 'Place', name: 'Dubai, United Arab Emirates' },
      founders: [{ '@type': 'Person', name: 'Leon Lumley-Savile' }, { '@type': 'Person', name: 'Tom Beenham' }],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: 'Valett',
      publisher: { '@id': `${site.url}/#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site.url}/#software`,
      name: 'Valett',
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Valet parking management software',
      operatingSystem: 'iOS, Android, Web',
      url: site.url,
      image: og,
      description: 'Valet management software for hotels, malls, restaurants and residences: check-in by photo with vehicle recognition, a digital ticket on the guest’s phone, requests, payments and tips by text, key and bay tracking, and reporting for operators.',
      featureList: [
        'Vehicle recognition from one photo (plate, make, model, colour)',
        'Digital valet ticket on the guest’s phone, no app',
        'Request the car from the table, pay and tip by text',
        'Key controller board for the shift manager',
        'Digital validation, residents’ plans, VIP tiers',
        'Reports per shift, per venue, per driver',
        'English and Arabic, white-label per venue',
      ],
      offers: { '@type': 'Offer', availability: 'https://schema.org/PreOrder', areaServed: 'AE', url: `${site.url}/#demo` },
      publisher: { '@id': `${site.url}/#organization` },
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="utf-8" />
    {/* Send any plain-http visit to https before anything else loads (backs up GitHub's Enforce HTTPS). */}
    <script is:inline>if (location.protocol === 'http:' && /(^|\.)valett\.si$/.test(location.hostname)) location.replace('https://valett.si' + location.pathname + location.search + location.hash);</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Valett" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Valett — A new era for a timeless service." />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Analytics after the page is idle, so it never competes with first paint. */}
    <script is:inline define:vars={{ domain: site.plausibleDomain }}>
      (function () {
        var load = function () { var s = document.createElement('script'); s.defer = true; s.dataset.domain = domain; s.src = 'https://plausible.io/js/script.outbound-links.js'; document.head.appendChild(s); };
        var later = function () { ('requestIdleCallback' in window) ? requestIdleCallback(load, { timeout: 4000 }) : setTimeout(load, 2000); };
        if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-ink antialiased" id="top">
    <a href="#main" class="sr-only-focusable z-[100] btn-primary">Skip to content</a>
    <slot />
    <script>
      // Scroll reveal, driven by IntersectionObserver so it works in a normal page and inside an
      // expanded iframe (where the window itself never scrolls).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const targets: { el: HTMLElement; delay: number }[] = [];
        document.querySelectorAll<HTMLElement>('[data-reveal-group] > .container-page').forEach((c) => {
          Array.from(c.children).forEach((el, i) => targets.push({ el: el as HTMLElement, delay: Math.min(i, 4) * 90 }));
        });
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => targets.push({ el, delay: 0 }));
        document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((c) => {
          Array.from(c.children).forEach((el, i) => targets.push({ el: el as HTMLElement, delay: Math.min(i, 7) * 90 }));
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
        document.documentElement.classList.add('reveal-ready');
        targets.forEach(({ el, delay }) => { el.style.transitionDelay = `${delay}ms`; io.observe(el); });
      }
    </script>
  </body>
</html>
