---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found — Valett" path="/404">
  <Nav />
  <main id="main" class="section-pad">
    <div class="container-page flex flex-col items-start gap-6">
      <p class="t-eyebrow">404</p>
      <h1 class="t-h2">That page is not parked here.</h1>
      <a href="/" class="btn-primary">Back to the front door</a>
    </div>
  </main>
  <Footer />
</Base>
