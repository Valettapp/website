---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Guest from '../components/Guest.astro';
import Staff from '../components/Staff.astro';
import BackOffice from '../components/BackOffice.astro';
import Money from '../components/Money.astro';
import Integrations from '../components/Integrations.astro';
import Faq from '../components/Faq.astro';
import Demo from '../components/Demo.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { solutions } from '../data/solutions';
import { site } from '../data/site';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const url = new URL(`/${s.slug}`, site.url).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: s.metaTitle, description: s.metaDescription, url, isPartOf: { '@type': 'WebSite', url: site.url, name: 'Valett' }, about: { '@type': 'SoftwareApplication', name: 'Valett' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Valett', item: site.url },
    { '@type': 'ListItem', position: 2, name: s.nav, item: url },
  ] },
];
---
<Base title={s.metaTitle} description={s.metaDescription} path={`/${s.slug}`} schema={schema}>
  <Nav />
  <main id="main">
    <section class="pt-28 pb-16 md:pt-40 md:pb-24" aria-labelledby="page-title">
      <div class="container-page">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="t-eyebrow">{s.eyebrow}</p>
            <h1 id="page-title" class="t-display mt-5 max-w-[12em] !text-[40px] md:!text-[64px]" style="text-wrap: balance">{s.h1}</h1>
            <p class="t-body measure mt-6 text-ink-2 md:text-[20px]">{s.lede}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
              <a href="#demo" class="btn-primary">Book a demo</a>
              <a href="#guest" class="btn-ghost glass">See the guest page</a>
            </div>
          </div>
          <ul class="flex flex-col lg:col-span-5 lg:pt-10">
            {s.points.map((p) => (
              <li class="hairline-t flex items-center gap-3 py-4 text-[16px] md:text-[17px]"><Icon name="check" size={14} class="shrink-0 text-gold" />{p}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section data-reveal-group class="section-pad !pt-0" aria-label="How it works">
      <div class="container-page">
        <div class="grid gap-10 md:grid-cols-3 md:gap-8">
          {s.body.map((b, i) => (
            <article class="hairline-t flex flex-col gap-3 pt-6">
              <p class="t-eyebrow">0{i + 1}</p>
              <h2 class="t-h3">{b.title}</h2>
              <p class="text-[16px] leading-relaxed text-ink-2 md:text-[17px]">{b.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {s.sections.includes('guest') && <Guest />}
    {s.sections.includes('staff') && <Staff />}
    {s.sections.includes('backoffice') && <BackOffice />}
    {s.sections.includes('money') && <Money />}
    {s.sections.includes('integrations') && <Integrations />}
    <Faq faqs={s.faqs} />
    <Demo />
  </main>
  <Footer />
</Base>
