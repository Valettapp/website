---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import TicketLoop from '../components/TicketLoop.astro';
import Guest from '../components/Guest.astro';
import Staff from '../components/Staff.astro';
import BackOffice from '../components/BackOffice.astro';
import Money from '../components/Money.astro';
import Integrations from '../components/Integrations.astro';
import Technology from '../components/Technology.astro';
import Renders from '../components/Renders.astro';
import WhoFor from '../components/WhoFor.astro';
import Plan from '../components/Plan.astro';
import Faq from '../components/Faq.astro';
import Solutions from '../components/Solutions.astro';
import Demo from '../components/Demo.astro';
import { faqHome } from '../data/solutions';
import { site } from '../data/site';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Why />
    {site.ticketLoop && <TicketLoop />}
    <Guest />
    <Staff />
    <BackOffice />
    <Money />
    <Integrations />
    <Technology />
    <Renders />
    <WhoFor />
    <Plan />
    <Faq faqs={faqHome} />
    <Demo />
    <Solutions />
  </main>
  <Footer />
</Base>
